---
interface Props {
  variant?: "full" | "mark";
  theme?: "light" | "dark";
  class?: string;
}

const {
  variant = "full",
  theme = "light",
  class: className = "",
} = Astro.props;

const isDark = theme === "dark";
---

<a
  href="/"
  class:list={["logo", className, { "logo-dark": isDark }]}
  aria-label="Blooming Systems Inc. home"
>
  <span class="logo-mark" aria-hidden="true">
    <svg
      viewBox="0 0 48 56"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <!-- Shield -->
      <path
        d="M24 2L44 9V25C44 38 36 48 24 54C12 48 4 38 4 25V9L24 2Z"
        fill="currentColor"
      />

      <!-- Fingerprint -->
      <path
        d="M15 25C15 18.925 19.029 14 24 14C28.971 14 33 18.925 33 25"
        stroke="white"
        stroke-width="2.5"
        stroke-linecap="round"
      />

      <path
        d="M12 25C12 17.268 17.373 11 24 11C30.627 11 36 17.268 36 25"
        stroke="white"
        stroke-width="2.5"
        stroke-linecap="round"
      />

      <path
        d="M18 25C18 20.582 20.686 17 24 17C27.314 17 30 20.582 30 25C30 32 28 36 24 41"
        stroke="white"
        stroke-width="2.5"
        stroke-linecap="round"
      />

      <path
        d="M21 25C21 22.239 22.343 20 24 20C25.657 20 27 22.239 27 25C27 30 26 33 24 36"
        stroke="white"
        stroke-width="2.5"
        stroke-linecap="round"
      />
    </svg>
  </span>

  {
    variant === "full" && (
      <span class="logo-text">
        <span class="logo-name">BLOOMING</span>
        <span class="logo-company">SYSTEMS INC.</span>
      </span>
    )
  }
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;

    color: #1769d1;
    text-decoration: none;

    flex-shrink: 0;
  }

  .logo-mark {
    display: block;
    width: 34px;
    height: 40px;
  }

  .logo-mark svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .logo-name {
    color: #07152f;
    font-size: 18px;
    font-weight: 750;
    letter-spacing: 0.045em;
  }

  .logo-company {
    margin-top: 5px;

    color: #697386;
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.22em;
  }

  /*
   * Dark variant
   */
  .logo-dark .logo-name {
    color: white;
  }

  .logo-dark .logo-company {
    color: #aab4c5;
  }

  /*
   * Mark-only variant
   */
  .logo[class*="mark"] {
    gap: 0;
  }

  @media (max-width: 480px) {
    .logo-mark {
      width: 29px;
      height: 35px;
    }

    .logo-name {
      font-size: 16px;
    }

    .logo-company {
      font-size: 7px;
    }
  }
</style>