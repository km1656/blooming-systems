---

<section class="hero">
  <div class="hero-grid">
    <div class="hero-content">
      <!-- <p class="eyebrow">
        IDENTITY & ACCESS MANAGEMENT
      </p> -->

      <h1>
        Secure identities.<br />
        Control access.<br />
        <span>Modernize your enterprise.</span>
      </h1>

      <p class="hero-description">
        Blooming Systems helps organizations design, implement, and
        operate identity and access infrastructure across cloud,
        hybrid, and on-premises environments.
      </p>

      <div class="hero-actions">
        <a href="/contact/" class="button button-primary">
          Talk to an IAM Expert
          <span aria-hidden="true">↗</span>
        </a>

        <a href="/services/" class="button button-secondary">
          Explore IAM Services
        </a>
      </div>

      <div class="hero-meta">
        <div>
          <strong>IAM</strong>
          <span>Strategy & Engineering</span>
        </div>

        <div>
          <strong>Cloud</strong>
          <span>Hybrid & On-Premises</span>
        </div>

        <div>
          <strong>Enterprise</strong>
          <span>Identity Infrastructure</span>
        </div>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <img
        class="hero-image"
        src="/images/hero-identity-network.png"
        alt=""
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
.hero {
  position: relative;
  min-height: calc(100vh - 82px);
  margin-top: -82px;
  padding-top: 82px;

  overflow: hidden;
  background: var(--color-blue-200);
}

  .hero-grid {
    width: min(
      var(--container),
      calc(100% - (var(--gutter) * 2))
    );

    min-height: calc(100vh - 82px);
    margin: 0 auto;

    display: grid;
    grid-template-columns:
      minmax(0, 1.05fr)
      minmax(420px, 0.95fr);

    align-items: center;
    gap: 80px;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding: 90px 0;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;

    margin: 0 0 28px;

    color: var(--color-blue);

    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  .eyebrow::before {
    content: "";

    width: 32px;
    height: 1px;

    background: var(--color-blue);
  }

  h1 {
    max-width: 780px;
    margin: 0;

    color: var(--color-ink);

    font-size: clamp(52px, 5.7vw, 88px);
    font-weight: 650;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  h1 span {
    color: var(--color-blue);
  }

  .hero-description {
    max-width: 590px;
    margin: 34px 0 0;

    color: var(--color-ink);

    font-size: 18px;
    line-height: 1.65;
    font-weight: 400;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 12px;

    margin-top: 38px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 12px;

    min-height: 50px;
    padding: 0 20px;

    font-size: 13px;
    font-weight: 650;
    text-decoration: none;

    transition:
      transform 160ms ease,
      background 160ms ease,
      color 160ms ease,
      border-color 160ms ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button-primary {
    color: var(--color-white);
    background: var(--color-ink);
  }

  .button-primary:hover {
    background: var(--color-blue);
  }

  .button-primary span {
    font-size: 17px;
  }

  .button-secondary {
    color: var(--color-ink);
    border: 1px solid var(--color-blue-800);
    background: transparent;
  }

  .button-secondary:hover {
    background: var(--color-white);
    border-color: var(--color-ink);
  }

  .hero-meta {
    display: flex;
    max-width: 650px;

    margin-top: 72px;

    border-top: 1px solid var(--color-blue-800);
  }

  .hero-meta > div {
    flex: 1;
    padding: 18px 20px 0 0;
  }

  .hero-meta > div + div {
    padding-left: 20px;
    border-left: 1px solid var(--color-blue-800);
  }

  .hero-meta strong,
  .hero-meta span {
    display: block;
  }

  .hero-meta strong {
    color: var(--color-ink);

    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-meta span {
    margin-top: 6px;

    color: var(--color-muted);

    font-size: 11px;
    line-height: 1.4;
  }

  /* Hero image */

  .hero-visual {
    position: relative;
    height: min(680px, 75vh);
    min-height: 500px;
    display: grid;
    place-items: center;
  }

  .hero-image {
    display: block;
    width: min(112%, 680px);
    max-height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 28px 42px rgba(21, 78, 144, 0.14));
  }

  @media (max-width: 1000px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .hero-content {
      padding-bottom: 30px;
    }

    .hero-visual {
      height: 500px;
      min-height: 0;
      margin-bottom: 50px;
    }
  }

  @media (max-width: 640px) {
    .hero-grid {
      width: calc(100% - (var(--gutter) * 2));
    }

    .hero-content {
      padding: 65px 0 20px;
    }

    h1 {
      font-size: clamp(44px, 13vw, 64px);
    }

    .hero-description {
      font-size: 16px;
    }

    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .button {
      justify-content: center;
    }

    .hero-meta {
      margin-top: 50px;
    }

    .hero-meta > div {
      padding-right: 10px;
    }

    .hero-meta > div + div {
      padding-left: 10px;
    }

    .hero-meta span {
      font-size: 9px;
    }

    .hero-visual {
      height: 400px;
    }

  }
</style>
