---
import Layout from "../../../layouts/Layout.astro";

const capabilities = [
  {
    number: "01",
    title: "Directory Integration",
    text: "Connect enterprise directories and identity platforms across cloud and on-premises environments.",
  },
  {
    number: "02",
    title: "Identity Synchronization",
    text: "Establish reliable identity and attribute synchronization between connected systems.",
  },
  {
    number: "03",
    title: "Cloud Identity",
    text: "Extend identity capabilities into cloud environments while maintaining appropriate enterprise controls.",
  },
  {
    number: "04",
    title: "Legacy Integration",
    text: "Connect applications and systems that were not designed for modern cloud identity patterns.",
  },
  {
    number: "05",
    title: "Federation",
    text: "Establish trust relationships between identity providers, applications, and enterprise environments.",
  },
  {
    number: "06",
    title: "Identity Modernization",
    text: "Create practical modernization paths that account for existing infrastructure and future architecture.",
  },
];

const model = [
  {
    number: "01",
    title: "Assess",
    text: "Understand the current directory, identity platform, application, and integration landscape.",
  },
  {
    number: "02",
    title: "Connect",
    text: "Establish the appropriate relationships between cloud and on-premises identity systems.",
  },
  {
    number: "03",
    title: "Synchronize",
    text: "Maintain consistent identity information across the systems that depend on it.",
  },
  {
    number: "04",
    title: "Modernize",
    text: "Move capabilities toward modern identity patterns while managing legacy dependencies.",
  },
  {
    number: "05",
    title: "Operate",
    text: "Maintain visibility, reliability, and operational control across the hybrid environment.",
  },
];
---

<Layout
  title="Hybrid Identity | Blooming Systems Inc."
  description="Hybrid identity solutions from Blooming Systems Inc. for directory integration, identity synchronization, cloud identity, legacy integration, federation, and identity modernization."
>
  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-content">
          <p class="section-eyebrow">HYBRID IDENTITY</p>

          <h1>
            Connect cloud and
            <span>on-premises identity.</span>
          </h1>

          <p class="hero-copy">
            Most enterprise identity environments are neither completely cloud
            nor completely on-premises. We help organizations connect existing
            infrastructure with modern identity platforms while creating a
            path toward the future.
          </p>

          <a href="/contact/" class="primary-link">
            Talk to an IAM Expert
            <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="hybrid-visual">
            <div class="cloud-node">
              <span>CLOUD</span>
              <strong>IDENTITY</strong>
            </div>

            <div class="onprem-node">
              <span>ON-PREMISES</span>
              <strong>DIRECTORY</strong>
            </div>

            <div class="hybrid-core">
              <span>HYBRID</span>
              <strong>IDENTITY</strong>
            </div>

            <div class="connection connection-one"></div>
            <div class="connection connection-two"></div>
            <div class="connection connection-three"></div>
          </div>
        </div>
      </div>
    </section>

    <section class="intro-section">
      <div class="container intro-grid">
        <div>
          <p class="section-eyebrow">THE CHALLENGE</p>

          <h2>
            Modernize identity without
            <span>ignoring what already exists.</span>
          </h2>
        </div>

        <div class="intro-copy">
          <p>
            Enterprise environments often contain Active Directory, legacy
            applications, on-premises infrastructure, cloud applications,
            SaaS platforms, and multiple identity services.
          </p>

          <p>
            Hybrid identity connects these environments so organizations can
            adopt modern identity capabilities without requiring every system
            to change at the same time.
          </p>
        </div>
      </div>
    </section>

    <section class="capabilities-section">
      <div class="container">
        <div class="section-heading">
          <p class="section-eyebrow">CAPABILITIES</p>

          <h2>
            One identity strategy
            <span>across multiple environments.</span>
          </h2>
        </div>

        <div class="capability-grid">
          {
            capabilities.map((item) => (
              <article class="capability-card">
                <span class="number">{item.number}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="model-section">
      <div class="container model-grid">
        <div>
          <p class="section-eyebrow">HYBRID IDENTITY MODEL</p>

          <h2>
            A practical path from
            <span>today's environment to tomorrow's.</span>
          </h2>

          <p class="model-copy">
            Hybrid identity modernization does not need to happen as a single
            transformation. A structured approach can connect current
            capabilities while progressively moving the architecture forward.
          </p>

          <a href="/services/cloud-identity/" class="text-link">
            Explore cloud identity services
            <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="model-list">
          {
            model.map((item) => (
              <div class="model-item">
                <span>{item.number}</span>

                <div>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="container cta-inner">
        <div>
          <p class="section-eyebrow">HYBRID IDENTITY</p>

          <h2>
            Connect today's identity environment
            <span>to tomorrow's architecture.</span>
          </h2>
        </div>

        <a href="/contact/" class="cta-button">
          Talk to an IAM Expert
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .container {
    width: min(var(--container), calc(100% - (var(--gutter) * 2)));
    margin: 0 auto;
  }

  .hero {
    min-height: calc(100vh - 82px);
    display: flex;
    align-items: center;
    background: #eef4ff;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 80px;
    align-items: center;
    padding: 85px 0;
  }

  .hero h1 {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(48px, 5.3vw, 76px);
    font-weight: 650;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  h1 span,
  h2 span {
    display: block;
    color: var(--color-blue);
  }

  .hero-copy {
    max-width: 570px;
    margin: 32px 0 38px;
    color: var(--color-text);
    font-size: 17px;
    line-height: 1.75;
  }

  .primary-link,
  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 19px;
    color: var(--color-white);
    background: var(--color-ink);
    border: 1px solid var(--color-ink);
    font-size: 13px;
    font-weight: 650;
    text-decoration: none;
    transition: background 160ms ease, border-color 160ms ease;
  }

  .primary-link:hover,
  .cta-button:hover {
    background: var(--color-blue);
    border-color: var(--color-blue);
  }

  .hero-visual {
    min-height: 540px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hybrid-visual {
    position: relative;
    width: min(100%, 570px);
    height: 480px;
  }

  .cloud-node,
  .onprem-node {
    position: absolute;
    z-index: 3;
    width: 180px;
    height: 180px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--color-ink);
    background: var(--color-white);
    border: 1px solid #cbd7eb;
    border-radius: 50%;
    box-shadow: 0 15px 35px rgba(7, 21, 47, 0.08);
    text-align: center;
  }

  .cloud-node {
    top: 35px;
    left: 0;
  }

  .onprem-node {
    right: 0;
    bottom: 35px;
  }

  .cloud-node span,
  .onprem-node span,
  .hybrid-core span {
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .cloud-node strong,
  .onprem-node strong {
    margin-top: 6px;
    font-size: 15px;
    font-weight: 650;
  }

  .hybrid-core {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 5;
    width: 175px;
    height: 175px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    background: var(--color-blue);
    border: 8px solid #dce7ff;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 22px 45px rgba(0, 49, 255, 0.2);
    text-align: center;
  }

  .hybrid-core strong {
    margin-top: 5px;
    font-size: 17px;
    font-weight: 650;
  }

  .connection {
    position: absolute;
    z-index: 1;
    height: 1px;
    background: rgba(0, 49, 255, 0.28);
    transform-origin: center;
  }

  .connection-one {
    top: 42%;
    left: 25%;
    width: 55%;
    transform: rotate(22deg);
  }

  .connection-two {
    top: 59%;
    left: 25%;
    width: 55%;
    transform: rotate(-22deg);
  }

  .connection-three {
    top: 50%;
    left: 22%;
    width: 56%;
    background: rgba(0, 49, 255, 0.13);
  }

  .intro-section,
  .model-section {
    padding: 135px 0;
    background: var(--color-white);
    border-top: 1px solid var(--color-border);
  }

  .intro-grid,
  .model-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 100px;
  }

  h2 {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(38px, 4vw, 58px);
    font-weight: 620;
    letter-spacing: -0.045em;
    line-height: 1.04;
  }

  .intro-copy {
    max-width: 650px;
  }

  .intro-copy p,
  .model-copy {
    margin: 0 0 24px;
    color: var(--color-text);
    font-size: 16px;
    line-height: 1.8;
  }

  .capabilities-section {
    padding: 135px 0;
    background: var(--color-ink);
  }
  .section-eyebrow{
    font-size: 15px;
  }

  .capabilities-section .section-eyebrow {
    color: #aeb9cc;
  }

  .capabilities-section .section-eyebrow::before {
    background: #aeb9cc;
  }

  .capabilities-section h2 {
    color: var(--color-white);
  }

  .capability-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 65px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .capability-card {
    min-height: 250px;
    padding: 30px;
    background: var(--color-ink);
  }

  .capability-card .number {
    color: #6d86ff;
    font-size: 40px;
    font-weight: 750;
    letter-spacing: 0.15em;
  }

  .capability-card h3 {
    margin: 42px 0 12px;
    color: var(--color-white);
    font-size: 21px;
    font-weight: 620;
  }

  .capability-card p {
    margin: 0;
    color: #aeb9cc;
    font-size: 13px;
    line-height: 1.7;
  }

  .model-copy {
    max-width: 550px;
    margin-top: 30px;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 5px;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-ink);
    font-size: 13px;
    font-weight: 650;
    text-decoration: none;
  }

  .text-link:hover {
    color: var(--color-blue);
    border-color: var(--color-blue);
  }

  .model-list {
    border-top: 1px solid var(--color-border);
  }

  .model-item {
    display: grid;
    grid-template-columns: 55px 1fr;
    gap: 20px;
    padding: 25px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .model-item > span {
    color: var(--color-blue);
    font-size: 40px;
    font-weight: 750;
    letter-spacing: 0.12em;
  }

  .model-item h3 {
    margin: 0 0 6px;
    color: var(--color-ink);
    font-size: 19px;
    font-weight: 620;
  }

  .model-item p {
    margin: 0;
    color: var(--color-text);
    font-size: 13px;
    line-height: 1.7;
  }

  .cta-section {
    padding: 105px 0;
    background: var(--color-blue);
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 60px;
  }

  .cta-section .section-eyebrow {
    color: var(--color-white);
  }

  .cta-section .section-eyebrow::before {
    background: var(--color-white);
  }

  .cta-section h2 {
    max-width: 800px;
    color: var(--color-white);
  }

  .cta-section h2 span {
    color: var(--color-white);
    opacity: 0.72;
  }

  .cta-button {
    flex-shrink: 0;
    color: var(--color-ink);
    background: var(--color-white);
    border-color: var(--color-white);
  }

  .cta-button:hover {
    color: var(--color-white);
    background: var(--color-ink);
    border-color: var(--color-ink);
  }

  @media (max-width: 1050px) {
    .hero-grid,
    .intro-grid,
    .model-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }

    .hero-visual {
      min-height: 470px;
    }

    .capability-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cta-inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 700px) {
    .hero {
      min-height: calc(100vh - 72px);
    }

    .hero-grid {
      padding: 65px 0 75px;
    }

    .hero h1 {
      font-size: clamp(43px, 12vw, 62px);
    }

    .hero-visual {
      min-height: 350px;
    }

    .hybrid-visual {
      width: 110%;
      margin-left: -5%;
      transform: scale(0.9);
    }

    .cloud-node,
    .onprem-node {
      width: 135px;
      height: 135px;
    }

    .hybrid-core {
      width: 135px;
      height: 135px;
    }

    .intro-section,
    .capabilities-section,
    .model-section {
      padding: 95px 0;
    }

    .capability-grid {
      grid-template-columns: 1fr;
    }

    .capability-card {
      min-height: auto;
    }

    .cta-section {
      padding: 80px 0;
    }
  }

  @media (max-width: 480px) {
    .hybrid-visual {
      transform: scale(0.78);
    }
  }
</style>