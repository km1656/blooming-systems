---
import Layout from "../../layouts/Layout.astro"

const solutions = [
  {
    number: "01",
    eyebrow: "WORKFORCE IDENTITY",
    title: "Give the right people the right access.",
    description:
      "Build secure workforce access across applications, cloud platforms, directories, and enterprise systems with identity at the center of the access experience.",
    capabilities: [
      "Single Sign-On",
      "MFA",
      "Lifecycle Management",
      "Conditional Access",
      "Application Access",
      "Federation",
    ],
  },
  {
    number: "02",
    eyebrow: "CUSTOMER IDENTITY",
    title: "Secure every digital customer interaction.",
    description:
      "Design scalable customer identity experiences that balance authentication, security, privacy, and frictionless access across digital channels.",
    capabilities: [
      "Customer IAM",
      "Adaptive Authentication",
      "Passwordless",
      "OAuth 2.0",
      "OpenID Connect",
      "Identity Federation",
    ],
  },
  {
    number: "03",
    eyebrow: "PRIVILEGED ACCESS",
    title: "Protect access to what matters most.",
    description:
      "Strengthen control over administrative and high-risk accounts through least privilege, governance, monitoring, and controlled privileged access.",
    capabilities: [
      "Privileged Accounts",
      "Least Privilege",
      "Session Management",
      "Credential Protection",
      "Access Controls",
      "Privileged Governance",
    ],
  },
  {
    number: "04",
    eyebrow: "IDENTITY GOVERNANCE",
    title: "Connect identity, access, and accountability.",
    description:
      "Bring lifecycle processes, access decisions, certification, policy, and compliance into a consistent identity governance framework.",
    capabilities: [
      "Joiner-Mover-Leaver",
      "Access Requests",
      "Access Reviews",
      "Role Management",
      "Segregation of Duties",
      "Compliance Reporting",
    ],
  },
  {
    number: "05",
    eyebrow: "HYBRID IDENTITY",
    title: "Modernize identity across every environment.",
    description:
      "Connect cloud identity platforms with enterprise directories and legacy infrastructure while maintaining security, continuity, and operational control.",
    capabilities: [
      "Hybrid Identity",
      "Active Directory",
      "Microsoft Entra ID",
      "Directory Integration",
      "Synchronization",
      "Migration",
    ],
  },
];

const architecture = [
  {
    number: "01",
    title: "People",
    description: "Employees, customers, partners, and administrators.",
  },
  {
    number: "02",
    title: "Identity",
    description: "Directories, identity providers, and governance platforms.",
  },
  {
    number: "03",
    title: "Access",
    description: "Applications, infrastructure, APIs, and privileged systems.",
  },
  {
    number: "04",
    title: "Control",
    description: "Policy, authentication, authorization, and governance.",
  },
];
---

<Layout>
  <main class="solutions-page">

    <!-- Hero -->
    <section class="solutions-hero">
      <div class="page-container">
        <div class="hero-grid">

          <div class="hero-content">
            <p class="eyebrow">IDENTITY SOLUTIONS</p>

            <h1>
              One identity strategy.
              <span>Multiple access domains.</span>
            </h1>

            <p class="hero-description">
              Identity requirements differ across employees, customers,
              privileged users, and hybrid environments. We design IAM
              architectures around how your organization actually operates.
            </p>

            <div class="hero-actions">
              <a href="/contact/" class="primary-button">
                Talk to an IAM Expert
                <span aria-hidden="true">↗</span>
              </a>

              <a href="#solution-areas" class="secondary-link">
                Explore solutions
                <span aria-hidden="true">↓</span>
              </a>
            </div>
          </div>

          <div class="hero-visual" aria-hidden="true">
            <div class="visual-frame">

              <div class="visual-top">
                <span>IDENTITY ARCHITECTURE</span>
                <span>BS / IAM</span>
              </div>

              <div class="architecture-diagram">

                <div class="diagram-line line-1"></div>
                <div class="diagram-line line-2"></div>
                <div class="diagram-line line-3"></div>
                <div class="diagram-line line-4"></div>

                <div class="architecture-node node-center">
                  <span>IDENTITY</span>
                  <strong>CONTROL</strong>
                </div>

                <div class="architecture-node node-1">
                  <span>WORKFORCE</span>
                </div>

                <div class="architecture-node node-2">
                  <span>CUSTOMER</span>
                </div>

                <div class="architecture-node node-3">
                  <span>PRIVILEGED</span>
                </div>

                <div class="architecture-node node-4">
                  <span>GOVERNANCE</span>
                </div>

              </div>

              <div class="visual-bottom">
                <span>SSO</span>
                <span>MFA</span>
                <span>IGA</span>
                <span>PAM</span>
                <span>DIRECTORY</span>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Solutions -->
    <section id="solution-areas" class="solutions-section">
      <div class="page-container">

        <div class="section-heading">
          <div>
            <p class="eyebrow">SOLUTION AREAS</p>

            <h2>
              Identity designed around
              <span> how access actually works.</span>
            </h2>
          </div>

          <p class="section-intro">
            From workforce access to privileged administration, we connect
            identity capabilities to the people, applications, and systems
            they need to access.
          </p>
        </div>

        <div class="solution-list">
          {solutions.map((solution) => (
            <article class="solution-row">

              <div class="solution-number">
                {solution.number}
              </div>

              <div class="solution-main">

                <p class="solution-eyebrow">
                  {solution.eyebrow}
                </p>

                <h3>{solution.title}</h3>

                <p class="solution-description">
                  {solution.description}
                </p>

              </div>

              <div class="solution-capabilities">
                {solution.capabilities.map((capability) => (
                  <span>{capability}</span>
                ))}
              </div>

            </article>
          ))}
        </div>

      </div>
    </section>

    <!-- Architecture -->
    <section class="architecture-section">
      <div class="page-container">

        <div class="architecture-grid">

          <div>
            <p class="eyebrow">THE IDENTITY LAYER</p>

            <h2>
              Identity connects
              <span> the enterprise.</span>
            </h2>
          </div>

          <div class="architecture-content">

            <p class="architecture-intro">
              Modern enterprise access depends on more than authentication.
              Identity connects people to applications, infrastructure,
              data, and administrative capabilities through a common control
              layer.
            </p>

            <div class="architecture-list">
              {architecture.map((item) => (
                <div class="architecture-item">
                  <span class="architecture-number">
                    {item.number}
                  </span>

                  <div>
                    <strong>{item.title}</strong>
                    <p>{item.description}</p>
                  </div>
                </div>
              ))}
            </div>

          </div>

        </div>

      </div>
    </section>

    <!-- Access domains -->
    <section class="domains-section">
      <div class="page-container">

        <div class="domains-header">
          <div>
            <p class="eyebrow">ACCESS DOMAINS</p>

            <h2>
              One control plane.
              <span>Different access requirements.</span>
            </h2>
          </div>

          <p>
            Each identity domain introduces different security, lifecycle,
            governance, and user-experience requirements.
          </p>
        </div>

        <div class="domains-grid">

          <div class="domain-card">
            <span>01</span>
            <h3>Workforce</h3>
            <p>
              Employees, contractors, and partners accessing enterprise
              applications and infrastructure.
            </p>
          </div>

          <div class="domain-card">
            <span>02</span>
            <h3>Customer</h3>
            <p>
              Customers and external users accessing digital products,
              services, and applications.
            </p>
          </div>

          <div class="domain-card">
            <span>03</span>
            <h3>Privileged</h3>
            <p>
              Administrators and high-risk identities requiring stronger
              controls and oversight.
            </p>
          </div>

          <div class="domain-card">
            <span>04</span>
            <h3>Governance</h3>
            <p>
              Policies, lifecycle processes, access decisions, certification,
              and compliance.
            </p>
          </div>

          <div class="domain-card">
            <span>05</span>
            <h3>Hybrid</h3>
            <p>
              Identity environments spanning cloud platforms, enterprise
              directories, and legacy systems.
            </p>
          </div>

        </div>

      </div>
    </section>

    <!-- Technology -->
    <section class="technology-strip">
      <div class="page-container">

        <div class="technology-header">
          <p class="eyebrow">TECHNOLOGY ECOSYSTEM</p>

          <a href="/technologies/" class="text-link">
            Explore technologies
            <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="technology-grid">
          <span>Microsoft Entra ID</span>
          <span>Okta</span>
          <span>Ping Identity</span>
          <span>ForgeRock</span>
          <span>SailPoint</span>
          <span>CyberArk</span>
          <span>Oracle IAM</span>
          <span>Active Directory</span>
          <span>LDAP</span>
          <span>OpenID Connect</span>
        </div>

      </div>
    </section>

    <!-- CTA -->
    <section class="solutions-cta">
      <div class="page-container">

        <div class="cta-inner">

          <div>
            <p class="eyebrow">START A CONVERSATION</p>

            <h2>
              Build an identity architecture
              <span> that fits your environment.</span>
            </h2>

            <p>
              Whether you're modernizing workforce access, strengthening
              privileged controls, implementing governance, or connecting
              cloud and on-premises identity, let's talk about the environment
              you're working with.
            </p>
          </div>

          <a href="/contact/" class="cta-button">
            Talk to an IAM Expert
            <span aria-hidden="true">↗</span>
          </a>

        </div>

      </div>
    </section>

  </main>
</Layout>

<style>
  .solutions-page {
    background: var(--color-white);
  }

  .page-container {
    width: min(
      calc(100% - (var(--gutter) * 2)),
      var(--container)
    );
    margin: 0 auto;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 26px;
    color: var(--color-blue);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .eyebrow::before {
    content: "";
    width: 28px;
    height: 1px;
    background: var(--color-blue);
  }

  /* Hero */

  .solutions-hero {
    padding: 116px 0 112px;
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-blue-200);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(420px, 0.8fr);
    gap: 90px;
    align-items: center;
  }

  .hero-content h1 {
    max-width: 800px;
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(48px, 5.8vw, 82px);
    font-weight: 650;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .hero-content h1 span {
    color: var(--color-blue);
  }

  .hero-description {
    max-width: 680px;
    margin: 32px 0 0;
    color: var(--color-text);
    font-size: 18px;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 42px;
  }

  .primary-button {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 52px;
    padding: 0 22px;
    background: var(--color-ink);
    color: white;
    font-size: 13px;
    font-weight: 650;
    text-decoration: none;
    transition:
      background 160ms ease,
      transform 160ms ease;
  }

  .primary-button:hover {
    background: var(--color-blue);
    transform: translateY(-1px);
  }

  .secondary-link,
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink);
    font-size: 13px;
    font-weight: 650;
    text-decoration: none;
  }

  .secondary-link {
    padding-bottom: 5px;
    border-bottom: 1px solid var(--color-ink);
  }

  .secondary-link:hover,
  .text-link:hover {
    color: var(--color-blue);
  }

  /* Visual */

  .visual-frame {
    position: relative;
    min-height: 500px;
    overflow: hidden;
    background: #07152f;
    color: white;
  }

  .visual-frame::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(
        rgba(255, 255, 255, 0.045) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.045) 1px,
        transparent 1px
      );
    background-size: 44px 44px;
  }

  .visual-top,
  .visual-bottom {
    position: absolute;
    left: 26px;
    right: 26px;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    color: #9daabd;
    font-size: 9px;
    font-weight: 650;
    letter-spacing: 0.14em;
  }

  .visual-top {
    top: 24px;
  }

  .visual-bottom {
    bottom: 24px;
    justify-content: flex-start;
    gap: 20px;
  }

  .architecture-diagram {
    position: absolute;
    inset: 75px 35px 70px;
  }

  .architecture-node {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 112px;
    height: 42px;
    border: 1px solid rgba(255,255,255,.22);
    background: rgba(7,21,47,.88);
    color: #dce5f2;
    font-size: 9px;
    font-weight: 650;
    letter-spacing: .11em;
  }

  .node-center {
    top: 50%;
    left: 50%;
    width: 132px;
    height: 132px;
    transform: translate(-50%, -50%);
    flex-direction: column;
    gap: 5px;
    border-color: rgba(22,166,160,.7);
    border-radius: 50%;
    background: #0d2847;
  }

  .node-center strong {
    color: white;
  }

  .node-1 {
    top: 10%;
    left: 8%;
  }

  .node-2 {
    top: 10%;
    right: 8%;
  }

  .node-3 {
    bottom: 10%;
    left: 8%;
  }

  .node-4 {
    right: 8%;
    bottom: 10%;
  }

  .diagram-line {
    position: absolute;
    z-index: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(22,166,160,.65),
      transparent
    );
    transform-origin: left center;
  }

  .line-1 {
    top: 26%;
    left: 19%;
    width: 30%;
    transform: rotate(29deg);
  }

  .line-2 {
    top: 26%;
    left: 51%;
    width: 30%;
    transform: rotate(-29deg);
  }

  .line-3 {
    top: 73%;
    left: 19%;
    width: 30%;
    transform: rotate(-29deg);
  }

  .line-4 {
    top: 73%;
    left: 51%;
    width: 30%;
    transform: rotate(29deg);
  }

  /* Solutions */

  .solutions-section {
    padding: 120px 0;
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, .55fr);
    gap: 80px;
    align-items: end;
    margin-bottom: 70px;
  }

  .section-heading h2,
  .architecture-grid h2,
  .domains-header h2,
  .solutions-cta h2 {
    max-width: 800px;
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(38px, 4.3vw, 60px);
    font-weight: 650;
    line-height: 1.04;
    letter-spacing: -.035em;
  }

  .section-heading h2 span,
  .architecture-grid h2 span,
  .domains-header h2 span,
  .solutions-cta h2 span {
    color: var(--color-blue);
  }

  .section-intro,
  .domains-header > p {
    margin: 0;
    color: var(--color-text);
    font-size: 16px;
    line-height: 1.75;
  }

  .solution-list {
    border-top: 1px solid var(--color-border);
  }

  .solution-row {
    display: grid;
    grid-template-columns: 70px minmax(280px,.9fr) minmax(300px,1fr);
    gap: 45px;
    padding: 42px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .solution-number {
    padding-top: 5px;
    color: var(--color-blue);
    font-size: 40px;
    font-weight: 700;
    letter-spacing: .12em;
  }

  .solution-eyebrow {
    margin: 0 0 12px;
    color: var(--color-blue);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .14em;
  }

  .solution-main h3 {
    margin: 0;
    color: var(--color-ink);
    font-size: 28px;
    font-weight: 650;
    letter-spacing: -.025em;
  }

  .solution-description {
    max-width: 560px;
    margin: 16px 0 0;
    color: var(--color-text);
    font-size: 15px;
    line-height: 1.7;
  }

  .solution-capabilities {
    display: flex;
    align-content: flex-start;
    flex-wrap: wrap;
    gap: 8px;
  }

  .solution-capabilities span {
    padding: 8px 10px;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 12px;
  }

  /* Architecture */

  .architecture-section {
    padding: 120px 0;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .architecture-grid {
    display: grid;
    grid-template-columns: minmax(0,.8fr) minmax(0,1fr);
    gap: 110px;
  }

  .architecture-intro {
    max-width: 680px;
    margin: 0 0 46px;
    color: var(--color-text);
    font-size: 17px;
    line-height: 1.75;
  }

  .architecture-list {
    border-top: 1px solid var(--color-border);
  }

  .architecture-item {
    display: grid;
    grid-template-columns: 45px 1fr;
    gap: 20px;
    padding: 22px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .architecture-number {
    color: var(--color-blue);
    font-size: 40px;
    font-weight: 700;
    letter-spacing: .12em;
  }

  .architecture-item strong {
    color: var(--color-ink);
    font-size: 15px;
  }

  .architecture-item p {
    margin: 6px 0 0;
    color: var(--color-muted);
    font-size: 13px;
    line-height: 1.6;
  }

  /* Domains */

  .domains-section {
    padding: 120px 0;
  }

  .domains-header {
    display: grid;
    grid-template-columns: minmax(0,1fr) minmax(300px,.55fr);
    gap: 80px;
    align-items: end;
    margin-bottom: 65px;
  }

  .domains-grid {
    display: grid;
    grid-template-columns: repeat(5,minmax(0,1fr));
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .domain-card {
    min-height: 270px;
    padding: 28px;
    border-right: 1px solid var(--color-border);
  }

  .domain-card:last-child {
    border-right: 0;
  }

  .domain-card > span {
    display: block;
    margin-bottom: 70px;
    color: var(--color-blue);
    font-size: 40px;
    font-weight: 700;
    letter-spacing: .14em;
  }

  .domain-card h3 {
    margin: 0 0 14px;
    color: var(--color-ink);
    font-size: 21px;
  }

  .domain-card p {
    margin: 0;
    color: var(--color-text);
    font-size: 13px;
    line-height: 1.65;
  }

  /* Technology */

  .technology-strip {
    padding: 55px 0;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .technology-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 30px;
  }

  .technology-header .eyebrow {
    margin: 0;
  }

  .technology-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .technology-grid span {
    padding: 9px 11px;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 12px;
  }

  /* CTA */

  .solutions-cta {
    padding: 120px 0;
  }

  .cta-inner {
    display: grid;
    grid-template-columns: minmax(0,1fr) auto;
    gap: 70px;
    align-items: end;
  }

  .solutions-cta h2 {
    max-width: 900px;
  }

  .solutions-cta > .page-container > .cta-inner > div > p:last-child {
    max-width: 720px;
    margin: 28px 0 0;
    color: var(--color-text);
    font-size: 16px;
    line-height: 1.75;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 54px;
    padding: 0 24px;
    background: var(--color-ink);
    color: white;
    font-size: 13px;
    font-weight: 650;
    text-decoration: none;
  }

  .cta-button:hover {
    background: var(--color-blue);
  }

  @media (max-width: 1050px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }

    .solution-row {
      grid-template-columns: 55px 1fr;
    }

    .solution-capabilities {
      grid-column: 2;
    }

    .domains-grid {
      grid-template-columns: repeat(3,1fr);
    }

    .domain-card:nth-child(3) {
      border-right: 0;
    }

    .domain-card:nth-child(4),
    .domain-card:nth-child(5) {
      border-top: 1px solid var(--color-border);
    }
  }

  @media (max-width: 800px) {
    .section-heading,
    .domains-header,
    .architecture-grid,
    .cta-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .domains-grid {
      grid-template-columns: 1fr 1fr;
    }

    .domain-card {
      border-bottom: 1px solid var(--color-border);
    }

    .domain-card:nth-child(2) {
      border-right: 0;
    }

    .domain-card:nth-child(3) {
      border-right: 1px solid var(--color-border);
    }

    .domain-card:nth-child(4) {
      border-right: 0;
    }

    .domain-card:nth-child(5) {
      grid-column: 1 / -1;
      border-right: 0;
    }
  }

  @media (max-width: 640px) {
    .solutions-hero {
      padding: 72px 0 70px;
    }

    .hero-content h1 {
      font-size: 44px;
    }

    .hero-actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 20px;
    }

    .visual-frame {
      min-height: 390px;
    }

    .solutions-section,
