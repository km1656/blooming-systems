---
import Layout from "../../layouts/Layout.astro";

const solutions = [
  {
    number: "01",
    title: "Workforce Identity",
    href: "/solutions/workforce-identity/",
    description:
      "Give employees and contractors secure, consistent access to the applications and resources they need across the organization.",
    capabilities: [
      "Single Sign-On",
      "Multi-Factor Authentication",
      "Joiner / Mover / Leaver",
      "Application Access",
    ],
  },
  {
    number: "02",
    title: "Customer Identity",
    href: "/solutions/customer-identity/",
    description:
      "Design customer identity experiences that balance secure authentication with simple, connected digital journeys.",
    capabilities: [
      "Customer Registration",
      "Authentication",
      "Identity Profiles",
      "Digital Experiences",
    ],
  },
  {
    number: "03",
    title: "Privileged Access",
    href: "/solutions/privileged-access/",
    description:
      "Protect elevated access to critical systems with stronger controls around privileged identities, credentials, and administrative activity.",
    capabilities: [
      "Privileged Accounts",
      "Elevated Access",
      "Credential Controls",
      "Access Monitoring",
    ],
  },
  {
    number: "04",
    title: "Identity Governance",
    href: "/solutions/identity-governance/",
    description:
      "Create a consistent framework for deciding who should have access, why they need it, and when that access should change.",
    capabilities: [
      "Access Requests",
      "Entitlement Management",
      "Access Certifications",
      "Lifecycle Governance",
    ],
  },
  {
    number: "05",
    title: "Hybrid Identity",
    href: "/solutions/hybrid-identity/",
    description:
      "Connect cloud and on-premises identity environments while maintaining a coherent identity architecture across the enterprise.",
    capabilities: [
      "Directory Integration",
      "Identity Synchronization",
      "Cloud Identity",
      "Legacy Integration",
    ],
  },
];

const principles = [
  {
    number: "01",
    title: "Identity first",
    text:
      "We treat identity as a foundational enterprise capability connecting people, applications, systems, and security controls.",
  },
  {
    number: "02",
    title: "Architecture matters",
    text:
      "Solutions should fit into the broader identity and technology environment rather than becoming isolated implementations.",
  },
  {
    number: "03",
    title: "Designed for operations",
    text:
      "Identity solutions need clear ownership, repeatable processes, and operational practices that work beyond implementation.",
  },
  {
    number: "04",
    title: "Built to evolve",
    text:
      "Identity environments change continuously. We design solutions that can adapt as applications, users, and business requirements change.",
  },
];
---

<Layout
  title="Identity Solutions | Blooming Systems Inc."
  description="Explore identity solutions from Blooming Systems Inc. across workforce identity, customer identity, privileged access, identity governance, and hybrid identity."
>
  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-content">
          <p class="section-eyebrow">IDENTITY SOLUTIONS</p>

          <h1>
            Identity solutions
            <span>built around the enterprise.</span>
          </h1>

          <p class="hero-copy">
            Identity connects people, applications, devices, data, and
            privileged access. We help organizations design identity solutions
            that work across those environments.
          </p>

          <div class="hero-actions">
            <a href="/contact/" class="primary-link">
              Talk to an IAM Expert
              <span aria-hidden="true">↗</span>
            </a>

            <a href="#solutions" class="secondary-link">
              Explore solutions
              <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="architecture">
            <div class="architecture-center">
              <span>IDENTITY</span>
              <strong>CONTROL</strong>
            </div>

            <div class="architecture-node node-one">
              <span>WORKFORCE</span>
            </div>

            <div class="architecture-node node-two">
              <span>CUSTOMER</span>
            </div>

            <div class="architecture-node node-three">
              <span>PRIVILEGED</span>
            </div>

            <div class="architecture-node node-four">
              <span>GOVERNANCE</span>
            </div>

            <div class="architecture-node node-five">
              <span>HYBRID</span>
            </div>

            <div class="architecture-line line-one"></div>
            <div class="architecture-line line-two"></div>
            <div class="architecture-line line-three"></div>
            <div class="architecture-line line-four"></div>
            <div class="architecture-line line-five"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Solutions -->
    <section class="solutions" id="solutions">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="section-eyebrow">OUR SOLUTIONS</p>

            <h2>
              Identity across
              <span>every access layer.</span>
            </h2>
          </div>

          <p class="section-intro">
            Different identity domains have different requirements. Our
            solutions address the major identity layers while maintaining a
            connected enterprise architecture.
          </p>
        </div>

        <div class="solution-grid">
          {
            solutions.map((solution) => (
              <article class="solution-card">
                <div class="card-top">
                  <span class="card-number">{solution.number}</span>

                  <a
                    href={solution.href}
                    class="card-arrow"
                    aria-label={`Explore ${solution.title}`}
                  >
                    ↗
                  </a>
                </div>

                <h3>{solution.title}</h3>

                <p>{solution.description}</p>

                <div class="capabilities">
                  {solution.capabilities.map((capability) => (
                    <span>{capability}</span>
                  ))}
                </div>

                <a href={solution.href} class="card-link">
                  Explore solution
                  <span aria-hidden="true">→</span>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Identity Architecture -->
    <section class="architecture-section">
      <div class="container architecture-grid">
        <div>
          <p class="section-eyebrow">ONE IDENTITY ARCHITECTURE</p>

          <h2>
            Solutions should connect,
            <span>not create more silos.</span>
          </h2>

          <p class="architecture-copy">
            Workforce, customer, privileged, governance, and hybrid identity
            capabilities often evolve independently. The result can be
            fragmented policies, duplicated processes, and disconnected
            operational models.
          </p>

          <p class="architecture-copy">
            We approach identity as an interconnected architecture, helping
            organizations establish the relationships between identity
            platforms, directories, applications, governance systems, and
            security controls.
          </p>

          <a href="/technologies/" class="text-link">
            Explore our technology ecosystem
            <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="architecture-panel">
          <div class="panel-header">
            <span>ENTERPRISE IDENTITY</span>
            <span>ARCHITECTURE</span>
          </div>

          <div class="architecture-stack">
            <div class="stack-row">
              <span class="stack-label">PEOPLE</span>
              <div class="stack-items">
                <span>Employees</span>
                <span>Customers</span>
                <span>Administrators</span>
              </div>
            </div>

            <div class="stack-row">
              <span class="stack-label">IDENTITY</span>
              <div class="stack-items">
                <span>Authentication</span>
                <span>Authorization</span>
                <span>Governance</span>
              </div>
            </div>

            <div class="stack-row">
              <span class="stack-label">PLATFORMS</span>
              <div class="stack-items">
                <span>Directories</span>
                <span>IGA</span>
                <span>PAM</span>
              </div>
            </div>

            <div class="stack-row">
              <span class="stack-label">APPLICATIONS</span>
              <div class="stack-items">
                <span>Cloud</span>
                <span>SaaS</span>
                <span>On-Premises</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Principles -->
    <section class="principles">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="section-eyebrow">OUR APPROACH</p>

            <h2>
              Identity designed for
              <span>real-world environments.</span>
            </h2>
          </div>

          <p class="section-intro">
            Effective identity solutions need to account for architecture,
            people, processes, technology, and ongoing operations.
          </p>
        </div>

        <div class="principle-grid">
          {
            principles.map((principle) => (
              <article class="principle">
                <span class="principle-number">{principle.number}</span>

                <h3>{principle.title}</h3>

                <p>{principle.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <div class="container cta-inner">
        <div>
          <p class="section-eyebrow">START WITH IDENTITY</p>

          <h2>
            Let's design the identity
            <span>foundation for what's next.</span>
          </h2>
        </div>

        <a href="/contact/" class="cta-button">
          Talk to an IAM Expert
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .container {
    width: min(var(--container), calc(100% - (var(--gutter) * 2)));
    margin: 0 auto;
  }

  .hero {
    min-height: calc(100vh - 82px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #eef4ff;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(400px, 0.9fr) minmax(480px, 1.1fr);
    gap: 70px;
    align-items: center;
    padding: 90px 0;
  }

  .hero-content {
    max-width: 680px;
  }

  .hero h1 {
    max-width: 680px;
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(48px, 5.2vw, 78px);
    font-weight: 650;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .hero h1 span,
  h2 span {
    display: block;
    color: var(--color-blue);
  }

  .hero-copy {
    max-width: 570px;
    margin: 34px 0 0;
    color: var(--color-text);
    font-size: 18px;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 25px;
    margin-top: 42px;
  }

  .primary-link,
  .secondary-link,
  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
  }

  .primary-link {
    padding: 14px 19px;
    color: var(--color-white);
    background: var(--color-ink);
    border: 1px solid var(--color-ink);
    font-size: 13px;
    font-weight: 650;
    transition:
      background 160ms ease,
      border-color 160ms ease;
  }

  .primary-link:hover {
    background: var(--color-blue);
    border-color: var(--color-blue);
  }

  .secondary-link {
    padding-bottom: 5px;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-ink);
    font-size: 13px;
    font-weight: 650;
  }

  .secondary-link:hover {
    color: var(--color-blue);
    border-color: var(--color-blue);
  }

  /* Hero architecture */

  .hero-visual {
    min-height: 570px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .architecture {
    position: relative;
    width: min(100%, 590px);
    aspect-ratio: 1;
  }

  .architecture::before,
  .architecture::after {
    content: "";
    position: absolute;
    inset: 13%;
    border: 1px solid rgba(0, 49, 255, 0.16);
    border-radius: 50%;
  }

  .architecture::after {
    inset: 25%;
    border-color: rgba(0, 49, 255, 0.24);
  }

  .architecture-center {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 3;

    width: 150px;
    height: 150px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    color: var(--color-white);
    background: var(--color-ink);
    border: 8px solid #dce7ff;
    border-radius: 50%;

    transform: translate(-50%, -50%);
    box-shadow: 0 20px 50px rgba(7, 21, 47, 0.18);
  }

  .architecture-center span {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .architecture-center strong {
    margin-top: 5px;
    font-size: 17px;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .architecture-node {
    position: absolute;
    z-index: 3;

    width: 105px;
    height: 105px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 15px;

    color: var(--color-ink);
    background: var(--color-white);
    border: 1px solid #cbd7ee;
    border-radius: 50%;

    text-align: center;

    box-shadow: 0 12px 35px rgba(7, 21, 47, 0.08);
  }

  .architecture-node span {
    font-size: 8px;
    font-weight: 750;
    letter-spacing: 0.1em;
  }

  .node-one {
    top: 4%;
    left: 50%;
    transform: translateX(-50%);
  }

  .node-two {
    top: 25%;
    right: 3%;
  }

  .node-three {
    right: 9%;
    bottom: 14%;
  }

  .node-four {
    bottom: 5%;
    left: 50%;
    transform: translateX(-50%);
  }

  .node-five {
    bottom: 14%;
    left: 9%;
  }

  .architecture-line {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;

    width: 42%;
    height: 1px;

    background: rgba(0, 49, 255, 0.25);
    transform-origin: left center;
  }

  .line-one {
    transform: rotate(-90deg);
  }

  .line-two {
    transform: rotate(-28deg);
  }

  .line-three {
    transform: rotate(28deg);
  }

  .line-four {
    transform: rotate(90deg);
  }

  .line-five {
    transform: rotate(152deg);
  }

  /* Solutions */

  .solutions {
    padding: 140px 0;
    background: var(--color-white);
    border-top: 1px solid var(--color-border);
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(300px, 0.9fr) minmax(300px, 0.65fr);
    gap: 90px;
    align-items: end;
    margin-bottom: 70px;
  }

  .section-heading h2,
  .architecture-section h2,
  .cta-section h2 {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(38px, 4vw, 58px);
    font-weight: 620;
    letter-spacing: -0.045em;
    line-height: 1.03;
  }

  .section-intro {
    max-width: 520px;
    margin: 0;
    color: var(--color-text);
    font-size: 16px;
    line-height: 1.75;
  }

  .solution-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .solution-card {
    min-height: 390px;
    display: flex;
    flex-direction: column;

    padding: 35px;

    background: var(--color-white);
    transition: background 180ms ease;
  }

  .solution-card:hover {
    background: #f7f9fc;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-number {
    color: var(--color-blue);
    font-size: 10px;
    font-weight: 750;
    letter-spacing: 0.15em;
  }

  .card-arrow {
    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: var(--color-ink);
    border: 1px solid var(--color-border);

    font-size: 16px;
    text-decoration: none;

    transition:
      background 160ms ease,
      color 160ms ease,
      border-color 160ms ease;
  }

  .solution-card:hover .card-arrow {
    color: var(--color-white);
    background: var(--color-blue);
    border-color: var(--color-blue);
  }

  .solution-card h3 {
    margin: 42px 0 14px;
    color: var(--color-ink);
    font-size: 28px;
    font-weight: 620;
    letter-spacing: -0.025em;
  }

  .solution-card p {
    max-width: 560px;
    margin: 0;
    color: var(--color-text);
    font-size: 14px;
    line-height: 1.7;
  }

  .capabilities {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 25px;
  }

  .capabilities span {
    padding: 6px 9px;
    color: #536074;
    background: #f2f5fa;
    font-size: 10px;
    font-weight: 600;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;

    margin-top: auto;
    padding-top: 30px;

    color: var(--color-ink);
    font-size: 12px;
    font-weight: 650;
    text-decoration: none;
  }

  .card-link:hover {
    color: var(--color-blue);
  }

  /* Architecture */

  .architecture-section {
    padding: 140px 0;
    background: #f7f9fc;
    border-top: 1px solid var(--color-border);
  }

  .architecture-grid {
    display: grid;
    grid-template-columns: minmax(300px, 0.8fr) minmax(450px, 1.2fr);
    gap: 100px;
    align-items: center;
  }

  .architecture-copy {
    max-width: 570px;
    margin: 28px 0 0;
    color: var(--color-text);
    font-size: 15px;
    line-height: 1.75;
  }

  .architecture-section .text-link {
    margin-top: 34px;
  }

  .architecture-panel {
    padding: 28px;
    background: var(--color-ink);
    color: var(--color-white);
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);

    color: #aeb9cc;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .architecture-stack {
    margin-top: 10px;
  }

  .stack-row {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .stack-row:last-child {
    border-bottom: 0;
  }

  .stack-label {
    padding-top: 3px;
    color: #7f8da5;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .stack-items {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .stack-items span {
    padding: 7px 9px;
    color: #dce4f3;
    border: 1px solid rgba(255, 255, 255, 0.13);
    font-size: 10px;
  }

  /* Principles */

  .principles {
    padding: 140px 0;
    background: var(--color-white);
    border-top: 1px solid var(--color-border);
  }

  .principle-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .principle {
    min-height: 250px;
    padding: 30px;
    background: var(--color-white);
  }

  .principle-number {
    color: var(--color-blue);
    font-size: 10px;
    font-weight: 750;
    letter-spacing: 0.15em;
  }

  .principle h3 {
    margin: 45px 0 12px;
    color: var(--color-ink);
    font-size: 20px;
    font-weight: 620;
  }

  .principle p {
    margin: 0;
    color: var(--color-text);
    font-size: 13px;
    line-height: 1.7;
  }

  /* CTA */

  .cta-section {
    padding: 105px 0;
    background: var(--color-blue);
  }

  .cta-section .section-eyebrow {
    color: var(--color-white);
  }

  .cta-section .section-eyebrow::before {
    background: var(--color-white);
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 60px;
  }

  .cta-section h2 {
    max-width: 800px;
    color: var(--color-white);
  }

  .cta-section h2 span {
    color: var(--color-white);
    opacity: 0.72;
  }

  .cta-button {
    flex-shrink: 0;

    padding: 15px 19px;

    color: var(--color-ink);
    background: var(--color-white);
    border: 1px solid var(--color-white);

    font-size: 12px;
    font-weight: 700;

    transition:
      background 160ms ease,
      color 160ms ease;
  }

  .cta-button:hover {
    color: var(--color-white);
    background: var(--color-ink);
    border-color: var(--color-ink);
  }

  @media (max-width: 1100px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .hero-content {
      max-width: 750px;
    }

    .hero-visual {
      min-height: 500px;
    }

    .section-heading {
      grid-template-columns: 1fr;
      gap: 25px;
    }

    .architecture-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }

    .principle-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cta-inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 700px) {
    .hero {
      min-height: calc(100vh - 72px);
    }

    .hero-grid {
      padding: 65px 0 75px;
    }

    .hero h1 {
      font-size: clamp(43px, 12vw, 62px);
    }

    .hero-copy {
      margin-top: 25px;
      font-size: 16px;
    }

    .hero-visual {
      min-height: 380px;
    }

    .architecture {
      width: 110%;
      margin-left: -5%;
    }

    .architecture-center {
      width: 120px;
      height: 120px;
    }

    .architecture-node {
      width: 82px;
      height: 82px;
    }

    .solutions,
    .architecture-section,
    .principles {
      padding: 95px 0;
    }

    .solution-grid {
      grid-template-columns: 1fr;
    }

    .solution-card {
      min-height: 350px;
    }

    .architecture-panel {
      padding: 20px;
    }

    .stack-row {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .principle-grid {
      grid-template-columns: 1fr;
    }

    .principle {
      min-height: auto;
    }

    .cta-section {
      padding: 80px 0;
    }

    .cta-section h2 {
      font-size: 40px;
    }
  }

  @media (max-width: 480px) {
    .hero-actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 20px;
    }

    .hero-visual {
      min-height: 330px;
    }

    .architecture-node span {
      font-size: 7px;
    }

    .architecture-center {
      width: 105px;
