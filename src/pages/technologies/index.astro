---
import Layout from "../../layouts/Layout.astro";

const platforms = [
  {
    number: "01",
    category: "MICROSOFT IDENTITY",
    title: "Microsoft Entra",
    description:
      "Cloud identity and access capabilities for workforce authentication, application access, conditional access, lifecycle management, and hybrid identity.",
    technologies: [
      "Microsoft Entra ID",
      "Conditional Access",
      "Microsoft Entra Connect",
      "Enterprise Applications",
      "B2B Collaboration",
      "B2C / External ID",
    ],
  },
  {
    number: "02",
    category: "OKTA",
    title: "Okta Identity Cloud",
    description:
      "Identity services for workforce and customer environments, with centralized authentication, application access, lifecycle management, and federation.",
    technologies: [
      "Workforce Identity",
      "Customer Identity",
      "Single Sign-On",
      "Universal Directory",
      "Lifecycle Management",
      "Adaptive MFA",
    ],
  },
  {
    number: "03",
    category: "PING IDENTITY",
    title: "Ping Identity",
    description:
      "Enterprise identity capabilities supporting authentication, federation, access management, and modern digital identity architectures.",
    technologies: [
      "PingFederate",
      "PingAccess",
      "PingDirectory",
      "PingOne",
      "Federation",
      "Adaptive Authentication",
    ],
  },
  {
    number: "04",
    category: "IDENTITY GOVERNANCE",
    title: "SailPoint",
    description:
      "Identity governance capabilities for access lifecycle, role management, certification, policy enforcement, and enterprise compliance.",
    technologies: [
      "Identity Governance",
      "Access Certification",
      "Lifecycle Management",
      "Role Management",
      "Access Requests",
      "Policy Management",
    ],
  },
  {
    number: "05",
    category: "PRIVILEGED ACCESS",
    title: "CyberArk",
    description:
      "Privileged access capabilities designed to protect administrative identities, credentials, sessions, and high-value systems.",
    technologies: [
      "Privileged Access",
      "Credential Vaulting",
      "Session Management",
      "Endpoint Privilege",
      "Secrets Management",
      "Privileged Governance",
    ],
  },
  {
    number: "06",
    category: "DIRECTORY SERVICES",
    title: "Enterprise Directories",
    description:
      "Directory and identity infrastructure connecting users, applications, systems, and authentication services across enterprise environments.",
    technologies: [
      "Active Directory",
      "LDAP",
      "Directory Services",
      "DNS Integration",
      "Group Management",
      "Directory Synchronization",
    ],
  },
];

const protocols = [
  {
    name: "SAML 2.0",
    description:
      "Federated authentication and single sign-on between identity providers and enterprise applications.",
  },
  {
    name: "OAuth 2.0",
    description:
      "Delegated authorization for applications, APIs, and modern digital services.",
  },
  {
    name: "OpenID Connect",
    description:
      "Modern authentication built on OAuth 2.0 for web, mobile, and API-driven applications.",
  },
  {
    name: "SCIM",
    description:
      "Standardized provisioning and lifecycle synchronization between identity platforms and applications.",
  },
  {
    name: "LDAP",
    description:
      "Directory access and identity integration across enterprise and legacy environments.",
  },
  {
    name: "Kerberos",
    description:
      "Enterprise authentication technology supporting traditional directory and Windows environments.",
  },
];

const architectureLayers = [
  {
    number: "01",
    title: "Identity Sources",
    description:
      "Directories, HR systems, customer databases, and authoritative identity sources.",
  },
  {
    number: "02",
    title: "Identity Platform",
    description:
      "Identity providers, directories, governance platforms, and privileged access systems.",
  },
  {
    number: "03",
    title: "Authentication",
    description:
      "SSO, MFA, passwordless authentication, federation, and adaptive access policies.",
  },
  {
    number: "04",
    title: "Applications",
    description:
      "SaaS applications, enterprise systems, custom applications, APIs, and infrastructure.",
  },
];
---

<Layout>
  <main class="technologies-page">

    <!-- Hero -->
    <section class="technology-hero">
      <div class="page-container">

        <div class="hero-grid">

          <div class="hero-content">

            <p class="eyebrow">IAM TECHNOLOGY</p>

            <h1>
              Identity technology
              <span>engineered around your environment.</span>
            </h1>

            <p class="hero-description">
              We work across the identity ecosystem to design, integrate,
              modernize, and operate identity platforms that support the way
              your organization actually works.
            </p>

            <div class="hero-actions">
              <a href="/contact/" class="primary-button">
                Talk to an IAM Expert
                <span aria-hidden="true">↗</span>
              </a>

              <a href="#platforms" class="secondary-link">
                Explore technology
                <span aria-hidden="true">↓</span>
              </a>
            </div>

          </div>

          <div class="hero-visual" aria-hidden="true">

            <div class="terminal">

              <div class="terminal-header">
                <span>IDENTITY / TECHNOLOGY</span>
                <span>BS-01</span>
              </div>

              <div class="terminal-body">

                <div class="terminal-line">
                  <span class="prompt">&gt;</span>
                  <span>identity.platform</span>
                  <strong>connected</strong>
                </div>

                <div class="terminal-line">
                  <span class="prompt">&gt;</span>
                  <span>authentication</span>
                  <strong>federated</strong>
                </div>

                <div class="terminal-line">
                  <span class="prompt">&gt;</span>
                  <span>provisioning</span>
                  <strong>automated</strong>
                </div>

                <div class="terminal-line">
                  <span class="prompt">&gt;</span>
                  <span>governance</span>
                  <strong>enabled</strong>
                </div>

                <div class="terminal-line">
                  <span class="prompt">&gt;</span>
                  <span>privileged.access</span>
                  <strong>protected</strong>
                </div>

                <div class="terminal-divider"></div>

                <div class="terminal-status">
                  <span>IDENTITY FABRIC</span>
                  <span class="status-dot"></span>
                  <span>OPERATIONAL</span>
                </div>

              </div>

            </div>

          </div>

        </div>

      </div>
    </section>

    <!-- Technology ecosystem -->
    <section id="platforms" class="platforms-section">
      <div class="page-container">

        <div class="section-heading">

          <div>
            <p class="eyebrow">TECHNOLOGY ECOSYSTEM</p>

            <h2>
              Platforms are tools.
              <span>Architecture is the outcome.</span>
            </h2>
          </div>

          <p class="section-intro">
            We work across leading identity platforms and enterprise
            technologies, selecting and integrating capabilities according to
            your security, operational, and business requirements.
          </p>

        </div>

        <div class="platform-list">

          {platforms.map((platform) => (
            <article class="platform-row">

              <div class="platform-number">
                {platform.number}
              </div>

              <div class="platform-main">

                <p class="platform-category">
                  {platform.category}
                </p>

                <h3>{platform.title}</h3>

                <p class="platform-description">
                  {platform.description}
                </p>

              </div>

              <div class="platform-technologies">

                {platform.technologies.map((technology) => (
                  <span>{technology}</span>
                ))}

              </div>

            </article>
          ))}

        </div>

      </div>
    </section>

    <!-- Capability matrix -->
    <section class="capabilities-section">

      <div class="page-container">

        <div class="capabilities-grid">

          <div>
            <p class="eyebrow">IAM CAPABILITIES</p>

            <h2>
              Technology mapped
              <span>to identity outcomes.</span>
            </h2>
          </div>

          <div class="capability-table">

            <div class="capability-row capability-header">
              <span>CAPABILITY</span>
              <span>WHAT IT ENABLES</span>
            </div>

            <div class="capability-row">
              <strong>Authentication</strong>
              <span>
                SSO, MFA, passwordless access, adaptive authentication
              </span>
            </div>

            <div class="capability-row">
              <strong>Authorization</strong>
              <span>
                Application access, policy enforcement, role-based access
              </span>
            </div>

            <div class="capability-row">
              <strong>Lifecycle</strong>
              <span>
                Joiner, mover, leaver processes and automated provisioning
              </span>
            </div>

            <div class="capability-row">
              <strong>Governance</strong>
              <span>
                Access reviews, certifications, policies, and compliance
              </span>
            </div>

            <div class="capability-row">
              <strong>Privileged Access</strong>
              <span>
                Credential protection, session control, and least privilege
              </span>
            </div>

            <div class="capability-row">
              <strong>Federation</strong>
              <span>
                Secure identity relationships between organizations and
                applications
              </span>
            </div>

          </div>

        </div>

      </div>

    </section>

    <!-- Protocols -->
    <section class="protocols-section">

      <div class="page-container">

        <div class="section-heading protocols-heading">

          <div>
            <p class="eyebrow">PROTOCOLS & STANDARDS</p>

            <h2>
              The standards
              <span>behind the integration.</span>
            </h2>
          </div>

          <p class="section-intro">
            Identity platforms only become useful when they integrate cleanly
            with the applications, directories, APIs, and systems around them.
          </p>

        </div>

        <div class="protocol-grid">

          {protocols.map((protocol) => (
            <article class="protocol-card">

              <span class="protocol-mark">&lt;/&gt;</span>

              <h3>{protocol.name}</h3>

              <p>{protocol.description}</p>

            </article>
          ))}

        </div>

      </div>

    </section>

    <!-- Architecture -->
    <section class="architecture-section">

      <div class="page-container">

        <div class="architecture-grid">

          <div class="architecture-heading">

            <p class="eyebrow">INTEGRATION ARCHITECTURE</p>

            <h2>
              Identity sits
              <span>between every layer.</span>
            </h2>

            <p>
              Successful IAM implementations connect authoritative identity
              sources to authentication, authorization, governance, and the
              applications people actually use.
            </p>

          </div>

          <div class="architecture-flow">

            {architectureLayers.map((layer) => (
              <div class="architecture-layer">

                <div class="layer-number">
                  {layer.number}
                </div>

                <div class="layer-content">
                  <strong>{layer.title}</strong>
                  <p>{layer.description}</p>
                </div>

                <span class="layer-arrow">↓</span>

              </div>
            ))}

          </div>

        </div>

      </div>

    </section>

    <!-- Modernization -->
    <section class="modernization-section">

      <div class="page-container">

        <div class="modernization-inner">

          <div>
            <p class="eyebrow">MODERNIZATION</p>

            <h2>
              Move from legacy identity
              <span>to a modern access architecture.</span>
            </h2>
          </div>

          <div class="modernization-content">

            <p>
              Identity modernization rarely means replacing everything at
              once. We help organizations establish a practical transition
              path between existing infrastructure and modern cloud identity
              services.
            </p>

            <div class="modernization-points">

              <div>
                <span>01</span>
                <strong>Assess</strong>
                <p>Understand the existing identity landscape.</p>
              </div>

              <div>
                <span>02</span>
                <strong>Integrate</strong>
                <p>Connect existing systems with modern platforms.</p>
              </div>

              <div>
                <span>03</span>
                <strong>Modernize</strong>
                <p>Move capabilities toward cloud and standards-based identity.</p>
              </div>

              <div>
                <span>04</span>
                <strong>Optimize</strong>
                <p>Improve security, automation, and operational visibility.</p>
              </div>

            </div>

          </div>

        </div>

      </div>

    </section>

    <!-- CTA -->
    <section class="technology-cta">

      <div class="page-container">

        <div class="cta-inner">

          <div>

            <p class="eyebrow">BUILD THE RIGHT FOUNDATION</p>

            <h2>
              Your identity environment is unique.
              <span>Your architecture should be too.</span>
            </h2>

            <p>
              Tell us what you're running today, where you're trying to go,
              and where identity is creating friction. We'll help map the
              technology to the architecture.
            </p>

          </div>

          <a href="/contact/" class="cta-button">
            Talk to an IAM Expert
            <span aria-hidden="true">↗</span>
          </a>

        </div>

      </div>

    </section>

  </main>
</Layout>

<style>
  .technologies-page {
    background: var(--color-white);
  }

  .page-container {
    width: min(
      calc(100% - (var(--gutter) * 2)),
      var(--container)
    );
    margin: 0 auto;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 26px;
    color: var(--color-blue);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .eyebrow::before {
    content: "";
    width: 28px;
    height: 1px;
    background: var(--color-blue);
  }

  /* Hero */

  .technology-hero {
    padding: 116px 0 112px;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(420px, 0.78fr);
    gap: 90px;
    align-items: center;
  }

  .hero-content h1 {
    max-width: 800px;
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(48px, 5.8vw, 82px);
    font-weight: 650;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .hero-content h1 span {
    color: #8792a3;
  }

  .hero-description {
    max-width: 680px;
    margin: 32px 0 0;
    color: var(--color-text);
    font-size: 18px;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 42px;
  }

  .primary-button {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 52px;
    padding: 0 22px;
    background: var(--color-ink);
    color: white;
    font-size: 13px;
    font-weight: 650;
    text-decoration: none;
    transition:
      background 160ms ease,
      transform 160ms ease;
  }

  .primary-button:hover {
    background: var(--color-blue);
    transform: translateY(-1px);
  }

  .secondary-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 5px;
    border-bottom: 1px solid var(--color-ink);
    color: var(--color-ink);
    font-size: 13px;
    font-weight: 650;
    text-decoration: none;
  }

  .secondary-link:hover {
    color: var(--color-blue);
  }

  /* Terminal */

  .terminal {
    overflow: hidden;
    min-height: 455px;
    background: #07152f;
    border: 1px solid #16345d;
    box-shadow: 0 30px 80px rgba(7, 21, 47, 0.12);
  }

  .terminal-header {
    display: flex;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid rgba(255,255,255,.1);
    color: #8495ad;
    font-size: 9px;
    font-weight: 650;
    letter-spacing: .14em;
  }

  .terminal-body {
    padding: 48px 30px;
  }

  .terminal-line {
    display: grid;
    grid-template-columns: 20px 1fr auto;
    gap: 8px;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid rgba(255,255,255,.07);
    color: #aab9cd;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 11px;
  }

  .terminal-line .prompt {
    color: #1aa69f;
  }

  .terminal-line strong {
    color: #d9e4f2;
    font-weight: 500;
  }

  .terminal-divider {
    height: 40px;
  }

  .terminal-status {
    display: flex;
    align-items: center;
    gap: 9px;
    color: #899ab0;
    font-size: 9px;
    font-weight: 650;
    letter-spacing: .12em;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #1aa69f;
    box-shadow: 0 0 14px rgba(26,166,159,.8);
  }

  /* Platforms */

  .platforms-section {
    padding: 120px 0;
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, .55fr);
    gap: 80px;
    align-items: end;
    margin-bottom: 70px;
  }

  .section-heading h2,
  .capabilities-grid h2,
  .architecture-heading h2,
  .modernization-inner h2,
  .technology-cta h2 {
    max-width: 800px;
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(38px, 4.3vw, 60px);
    font-weight: 650;
    line-height: 1.04;
    letter-spacing: -.035em;
  }

  .section-heading h2 span,
  .capabilities-grid h2 span,
  .architecture-heading h2 span,
  .modernization-inner h2 span,
  .technology-cta h2 span {
    color: #8792a3;
  }

  .section-intro {
    margin: 0;
    color: var(--color-text);
    font-size: 16px;
    line-height: 1.75;
  }

  .platform-list {
    border-top: 1px solid var(--color-border);
  }

  .platform-row {
    display: grid;
    grid-template-columns: 70px minmax(280px,.9fr) minmax(300px,1fr);
    gap: 45px;
    padding: 42px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .platform-number {
    padding-top: 5px;
    color: var(--color-blue);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
  }

  .platform-category {
    margin: 0 0 12px;
    color: var(--color-blue);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .14em;
  }

  .platform-main h3 {
    margin: 0;
    color: var(--color-ink);
    font-size: 28px;
    font-weight: 650;
    letter-spacing: -.025em;
  }

  .platform-description {
    max-width: 560px;
    margin: 16px 0 0;
    color: var(--color-text);
    font-size: 15px;
    line-height: 1.7;
  }

  .platform-technologies {
    display: flex;
    align-content: flex-start;
    flex-wrap: wrap;
    gap: 8px;
  }

  .platform-technologies span {
    padding: 8px 10px;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 12px;
  }

  /* Capabilities */

  .capabilities-section {
    padding: 120px 0;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .capabilities-grid {
    display: grid;
    grid-template-columns: minmax(0,.72fr) minmax(0,1fr);
    gap: 110px;
  }

  .capability-table {
    border-top: 1px solid var(--color-border);
  }

  .capability-row {
    display: grid;
    grid-template-columns: minmax(130px,.55fr) minmax(0,1fr);
    gap: 30px;
    padding: 21px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .capability-row span,
  .capability-row strong {
    color: var(--color-text);
    font-size: 13px;
    line-height: 1.6;
  }

  .capability-row strong {
    color: var(--color-ink);
    font-weight: 650;
  }

  .capability-header {
    padding: 12px 0;
  }

  .capability-header span {
    color: var(--color-muted);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .13em;
  }

  /* Protocols */

  .protocols-section {
    padding: 120px 0;
  }

  .protocol-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0,1fr));
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .protocol-card {
    min-height: 245px;
    padding: 30px;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .protocol-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    margin-bottom: 55px;
    border: 1px solid var(--color-border);
    color: var(--color-blue);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 11px;
  }

  .protocol-card h3 {
    margin: 0 0 12px;
    color: var(--color-ink);
    font-size: 20px;
    font-weight: 650;
  }

  .protocol-card p {
    margin: 0;
    color: var(--color-text);
    font-size: 13px;
    line-height: 1.65;
  }

  /* Architecture */

  .architecture-section {
    padding: 120px 0;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .architecture-grid {
    display: grid;
    grid-template-columns: minmax(0,.8fr) minmax(0,1fr);
    gap: 110px;
  }

  .architecture-heading > p:last-child {
    max-width: 600px;
    margin: 30px 0 0;
    color: var(--color-text);
    font-size: 16px;
    line-height: 1.75;
  }

  .architecture-flow {
    border-top: 1px solid var(--color-border);
  }

  .architecture-layer {
    position: relative;
    display: grid;
    grid-template-columns: 45px 1fr 20px;
    gap: 20px;
    padding: 25px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .layer-number {
    color: var(--color-blue);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .12em;
  }

  .layer-content strong {
    color: var(--color-ink);
    font-size: 16px;
  }

  .layer-content p {
    margin: 7px 0 0;
    color: var(--color-muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .layer-arrow {
    color: var(--color-blue);
    font-size: 15px;
  }

  .architecture-layer:last-child .layer-arrow {
    visibility: hidden;
  }

  /* Modernization */

  .modernization-section {
    padding: 120px 0;
  }

  .modernization-inner {
    display: grid;
    grid-template-columns: minmax(0,.8fr) minmax(0,1fr);
    gap: 110px;
  }

  .modernization-content > p {
    max-width: 650px;
    margin: 0 0 50px;
    color: var(--color-text);
    font-size: 17px;
    line-height: 1.75;
  }

  .modernization-points {
    border-top: 1px solid var(--color-border);
  }

  .modernization-points > div {
    display: grid;
    grid-template-columns: 42px 100px 1fr;
    gap: 20px;
    align-items: baseline;
    padding: 19px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .modernization-points span {
    color: var(--color-blue);
    font-size: 10px;
    font-weight: 700;
  }

  .modernization-points strong {
    color: var(--color-ink);
    font-size: 14px;
  }

  .modernization-points p {
    margin: 0;
    color: var(--color-muted);
    font-size: 13px;
  }

  /* CTA */

  .technology-cta {
    padding: 120px 0;
    border-top: 1px solid var(--color-border);
  }

  .cta-inner {
    display: grid;
