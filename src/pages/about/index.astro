---
import Layout from "../../layouts/Layout.astro";

const capabilities = [
  {
    number: "01",
    title: "Identity Strategy",
    text: "We help organizations define an identity strategy aligned with security objectives, technology investments, and business priorities.",
  },
  {
    number: "02",
    title: "Architecture & Engineering",
    text: "We design and implement identity architectures that connect directories, applications, cloud platforms, privileged access, and governance.",
  },
  {
    number: "03",
    title: "Integration & Modernization",
    text: "We bring together existing identity environments and modern cloud services while reducing complexity across the enterprise.",
  },
  {
    number: "04",
    title: "Operational Excellence",
    text: "We help establish the processes, controls, and operating practices required to keep identity services reliable and effective.",
  },
];

const principles = [
  {
    number: "01",
    title: "Identity first",
    text: "Identity sits at the center of how people, applications, devices, and services interact. We treat it as a foundational enterprise capability.",
  },
  {
    number: "02",
    title: "Engineering over abstraction",
    text: "Strategy matters, but it has to become working technology. Our approach connects architecture decisions to implementation and operational outcomes.",
  },
  {
    number: "03",
    title: "Built for the real environment",
    text: "Most enterprises operate across legacy directories, SaaS platforms, cloud infrastructure, and custom applications. We design for that reality.",
  },
  {
    number: "04",
    title: "Long-term partnership",
    text: "Identity programs evolve continuously. We focus on building foundations that organizations can operate, extend, and improve over time.",
  },
];

const technologyAreas = [
  "Microsoft Entra",
  "Active Directory",
  "Okta",
  "Ping Identity",
  "SailPoint",
  "CyberArk",
  "LDAP",
  "SAML",
  "OAuth 2.0",
  "OpenID Connect",
];
---

<Layout
  title="About | Blooming Systems Inc."
  description="Learn about Blooming Systems Inc., an identity and technology services company helping organizations design, integrate, modernize, and operate enterprise identity environments."
>
  <main>
    <!-- HERO -->
    <section class="about-hero">
      <div class="hero-grid">
        <div class="hero-content">
          <p class="section-eyebrow">ABOUT BLOOMING SYSTEMS</p>

          <h1>
            Identity is infrastructure.
            <span>We help organizations build it right.</span>
          </h1>

          <p class="hero-copy">
            Blooming Systems Inc. helps organizations design, implement, and
            modernize the identity foundations that connect people,
            applications, systems, and business operations.
          </p>

          <div class="hero-meta">
            <div>
              <span class="meta-label">FOCUS</span>
              <span class="meta-value">Identity &amp; Technology</span>
            </div>

            <div>
              <span class="meta-label">APPROACH</span>
              <span class="meta-value">Strategy through execution</span>
            </div>
          </div>
        </div>
        <div class="identity-visual">
      <img
        class="identity-image"
        src="/images/identity-control.png"
        alt="Isometric identity and access architecture showing workforce, customer, privileged access, and governance connected through a central identity control layer"
        width="1536"
        height="1024"
        loading="eager"
        decoding="async"
      />
    </div>


      </div>
    </section>

    <!-- INTRO -->
    <section class="about-intro">
      <div class="section-grid">
        <div>
          <p class="section-eyebrow">WHO WE ARE</p>

          <h2>
            Technology services with
            <span>identity at the center.</span>
          </h2>
        </div>

        <div class="intro-copy">
          <p>
            Modern organizations depend on identity across nearly every
            layer of their technology environment. Employees need access to
            applications. Customers need secure digital experiences.
            Administrators need controlled privileged access. Applications
            and services need to establish trust with one another.
          </p>

          <p>
            Blooming Systems focuses on the identity layer that connects
            these environments. We combine consulting, architecture,
            implementation, integration, and platform expertise to help
            organizations create identity environments that are secure,
            scalable, and operationally practical.
          </p>
        </div>
      </div>
    </section>

    <!-- CAPABILITIES -->
    <section class="capabilities">
      <div class="section-heading">
        <div>
          <p class="section-eyebrow">WHAT WE DO</p>

          <h2>
            From identity strategy to
            <span>working systems.</span>
          </h2>
        </div>

        <p>
          Our work spans the identity lifecycle—from defining the target
          architecture to integrating platforms and improving day-to-day
          operations.
        </p>
      </div>

      <div class="capability-grid">
        {
          capabilities.map((item) => (
            <article class="capability-card">
              <span class="card-number">{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <span class="card-arrow">↗</span>
            </article>
          ))
        }
      </div>
    </section>

    <!-- PRINCIPLES -->
    <section class="principles">
      <div class="principles-intro">
        <p class="section-eyebrow">HOW WE WORK</p>

        <h2>
          Practical thinking.
          <span>Technical execution.</span>
        </h2>

        <p>
          Identity programs often cross security, infrastructure,
          applications, compliance, and business operations. Our approach is
          designed to connect those disciplines rather than treat identity
          as an isolated technology project.
        </p>
      </div>

      <div class="principles-list">
        {
          principles.map((item) => (
            <div class="principle">
              <span>{item.number}</span>

              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- TECHNOLOGY -->
    <section class="technology">
      <div class="technology-header">
        <div>
          <p class="section-eyebrow">TECHNOLOGY ECOSYSTEM</p>

          <h2>
            Experience across the
            <span>identity stack.</span>
          </h2>
        </div>

        <p>
          We work across established enterprise platforms, cloud identity
          services, directories, governance systems, privileged access
          platforms, and modern identity protocols.
        </p>
      </div>

      <div class="technology-list">
        {
          technologyAreas.map((technology, index) => (
            <div class="technology-item">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{technology}</strong>
            </div>
          ))
        }
      </div>

      <a href="/technologies/" class="text-link">
        Explore our technology capabilities
        <span>↗</span>
      </a>
    </section>

    <!-- COMPANY -->
    <section class="company">
      <div class="company-grid">
        <div>
          <p class="section-eyebrow">BLOOMING SYSTEMS INC.</p>

          <h2>
            Professional technology services
            <span>for the identity-driven enterprise.</span>
          </h2>
        </div>

        <div class="company-details">
          <div class="detail">
            <span>HEADQUARTERS</span>

            <p>
              21951 Purebred Lane<br />
              Escondido, CA 92029
            </p>
          </div>

          <div class="detail">
            <span>CONTACT</span>

            <p>
              <a href="tel:+18587407673">858 740 7673</a><br />
              <a href="/contact/">Contact Blooming Systems</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="about-cta">
      <div>
        <p class="section-eyebrow">START A CONVERSATION</p>

        <h2>
          Building an identity
          <span>foundation?</span>
        </h2>

        <p>
          Tell us where your identity environment is today and where you
          need it to go.
        </p>

        <a href="/contact/" class="cta-button">
          Talk to Blooming Systems
          <span>↗</span>
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* -----------------------------------------
     HERO
  ----------------------------------------- */

  .about-hero {
    position: relative;
    overflow: hidden;
    background: #eef4ff;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-grid {
    width: min(var(--container), calc(100% - (var(--gutter) * 2)));
    min-height: 760px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(500px, 1.1fr);
    align-items: center;
    gap: 70px;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 650px;
    padding: 100px 0;
  }

  .hero-content h1 {
    max-width: 680px;
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(48px, 5vw, 78px);
    font-weight: 650;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .hero-content h1 span {
    display: block;
    margin-top: 12px;
    color: var(--color-blue);
  }

  .hero-copy {
    max-width: 570px;
    margin: 34px 0 0;
    color: var(--color-text);
    font-size: 18px;
    line-height: 1.75;
  }

  .hero-meta {
    display: flex;
    gap: 55px;
    margin-top: 55px;
    padding-top: 24px;
    border-top: 1px solid rgba(7, 21, 47, 0.16);
  }

  .hero-meta div {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .meta-label {
    color: var(--color-blue);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .meta-value {
    color: var(--color-ink);
    font-size: 13px;
    font-weight: 600;
  }

  /* -----------------------------------------
     HERO VISUAL
  ----------------------------------------- */

  .hero-visual {
    position: relative;
    height: 650px;
    overflow: hidden;
  }

  .visual-grid {
    position: absolute;
    inset: 5% 0 0;
    opacity: 0.55;
    background-image:
      linear-gradient(rgba(0, 49, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 49, 255, 0.08) 1px, transparent 1px);
    background-size: 42px 42px;
    transform: perspective(700px) rotateX(62deg) rotateZ(-10deg) scale(1.45);
    transform-origin: center center;
  }

  .identity-orbit {
    position: absolute;
    left: 50%;
    top: 50%;
    border: 1px solid rgba(0, 49, 255, 0.22);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .orbit-one {
    width: 430px;
    height: 430px;
  }

  .orbit-two {
    width: 570px;
    height: 570px;
    border-style: dashed;
    opacity: 0.65;
  }

  .visual-core {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 245px;
    height: 205px;
    transform: translate(-50%, -50%) rotate(-3deg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(7, 21, 47, 0.97);
    border: 1px solid rgba(0, 49, 255, 0.55);
    box-shadow:
      22px 24px 0 rgba(0, 49, 255, 0.09),
      0 30px 70px rgba(7, 21, 47, 0.18);
  }

  .visual-core::before {
    content: "";
    position: absolute;
    inset: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .core-label {
    position: relative;
    color: #9eb9ff;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  .visual-core strong {
    position: relative;
    margin-top: 7px;
    color: white;
    font-size: 30px;
    letter-spacing: -0.04em;
  }

  .core-line {
    position: relative;
    width: 42px;
    height: 2px;
    margin: 13px 0;
    background: var(--color-blue);
  }

  .visual-core small {
    position: relative;
    color: rgba(255, 255, 255, 0.55);
    font-size: 7px;
    letter-spacing: 0.16em;
  }

  .visual-node {
    position: absolute;
    min-width: 125px;
    padding: 12px 15px;
    background: rgba(255, 255, 255, 0.86);
    border: 1px solid rgba(0, 49, 255, 0.2);
    box-shadow: 0 12px 30px rgba(7, 21, 47, 0.08);
    color: var(--color-ink);
    font-size: 11px;
    font-weight: 650;
    backdrop-filter: blur(8px);
  }

  .visual-node span {
    display: block;
    margin-bottom: 4px;
    color: var(--color-blue);
    font-size: 8px;
    letter-spacing: 0.12em;
  }

  .node-one {
    left: 4%;
    top: 23%;
  }

  .node-two {
    right: 4%;
    top: 19%;
  }

  .node-three {
    left: 2%;
    bottom: 22%;
  }

  .node-four {
    right: 4%;
    bottom: 19%;
  }

  .visual-node::after {
    content: "";
    position: absolute;
    width: 75px;
    height: 1px;
    background: rgba(0, 49, 255, 0.3);
  }

  .node-one::after,
  .node-three::after {
    right: -75px;
  }

  .node-two::after,
  .node-four::after {
    left: -75px;
  }

  /* -----------------------------------------
     INTRO
  ----------------------------------------- */

  .about-intro {
    padding: 145px 0;
    background: var(--color-blue-50);
  }
  

  .section-grid {
    width: min(var(--container), calc(100% - (var(--gutter) * 2)));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 110px;
  }

  .section-grid h2,
  .section-heading h2,
  .principles-intro h2,
  .technology-header h2,
  .company h2,
  .about-cta h2 {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(38px, 4vw, 58px);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  .section-grid h2 span,
  .section-heading h2 span,
  .principles-intro h2 span,
  .technology-header h2 span,
  .company h2 span,
  .about-cta h2 span {
    display: block;
    color: var(--color-blue);
  }

  .intro-copy {
    max-width: 650px;
  }

  .intro-copy p {
    margin: 0 0 25px;
    color: var(--color-text);
    font-size: 17px;
    line-height: 1.8;
  }

  .intro-copy p:last-child {
    margin-bottom: 0;
  }

  /* -----------------------------------------
     CAPABILITIES
  ----------------------------------------- */

 .capabilities {
  padding: 125px 0;
  background-color: var(--color-blue);
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}

.capabilities .section-heading h2 span {
  color: var(--color-white);
}
.capabilities .section-heading h2 {
  color: var(--color-white);
}
.capabilities .section-eyebrow{
    color: var(--color-white);
}

.capabilities .section-eyebrow::before {
  content: "";
  width: 28px;
  height: 1px;
  background: var(--color-white);
}

  .section-heading {
    width: min(var(--container), calc(100% - (var(--gutter) * 2)));
    margin: 0 auto 70px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.65fr);
    gap: 100px;
    align-items: end;
    color: var(--color-surface);
  }

  .section-heading > p {
    max-width: 470px;
    margin: 0;
    color: var(--color-white);
    font-size: 15px;
    line-height: 1.8;
  }

  .capability-grid {
    width: min(var(--container), calc(100% - (var(--gutter) * 2)));
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .capability-card {
    position: relative;
    min-height: 350px;
    padding: 32px;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-white);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .capability-card:hover {
    z-index: 1;
    transform: translateY(-5px);
    box-shadow: 0 20px 45px rgba(7, 21, 47, 0.08);
  }

  .card-number {
    color: var(--color-blue);
    font-size: 40px;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .capability-card h3 {
    margin: 95px 0 18px;
    color: var(--color-ink);
    font-size: 21px;
    letter-spacing: -0.025em;
  }

  .capability-card p {
    margin: 0;
    color: var(--color-text);
    font-size: 14px;
    line-height: 1.75;
  }

  .card-arrow {
    position: absolute;
    right: 30px;
    bottom: 27px;
    color: var(--color-blue);
    font-size: 18px;
  }

  /* -----------------------------------------
     PRINCIPLES
  ----------------------------------------- */

  .principles {
    width: min(var(--container), calc(100% - (var(--gutter) * 2)));
    margin: 0 auto;
    padding: 145px 0;
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) minmax(450px, 1.2fr);
    gap: 120px;
  }

  .principles-intro {
    max-width: 500px;
  }

  .principles-intro > p:last-child {
    margin: 35px 0 0;
    color: var(--color-text);
    font-size: 15px;
    line-height: 1.8;
  }

  .principles-list {
    border-top: 1px solid var(--color-border);
  }

  .principle {
    display: grid;
    grid-template-columns: 55px 1fr;
    gap: 30px;
    padding: 30px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .principle > span {
    color: var(--color-blue);
    font-size: 40px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .principle h3 {
    margin: 0 0 9px;
    color: var(--color-ink);
    font-size: 19px;
    letter-spacing: -0.02em;
  }

  .principle p {
    max-width: 590px;
    margin: 0;
    color: var(--color-text);
    font-size: 14px;
    line-height: 1.75;
  }

  /* -----------------------------------------
     TECHNOLOGY
  ----------------------------------------- */

  .technology {
    padding: 125px 0;
    background: #07152f;
  }

  .technology-header {
    width: min(var(--container), calc(100% - (var(--gutter) * 2)));
    margin: 0 auto 70px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.65fr);
    gap: 100px;
    align-items: end;
  }
  .section-eyebrow{
    font-size: 15px;
  }

  .technology-header .section-eyebrow {
    color: #8caaff;
  }

  .technology-header .section-eyebrow::before {
    background: #8caaff;
  }

  .technology-header h2 {
    color: white;
  }

  .technology-header > p {
    max-width: 470px;
    margin: 0;
    color: rgba(255, 255, 255, 0.62);
    font-size: 15px;
    line-height: 1.8;
  }

  .technology-list {
    width: min(var(--container), calc(100% - (var(--gutter) * 2)));
    margin: 0 auto 55px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-left: 1px solid rgba(255, 255, 255, 0.12);
  }

  .technology-item {
    min-height: 115px;
    padding: 36px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-right: 1px solid rgba(255, 255, 255, 0.12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .technology-item span {
    color: #6e8cff;
    font-size: 15px;
    letter-spacing: 0.12em;
  }

  .technology-item strong {
    color: white;
    font-size: 14px;
    font-weight: 600;
  }

  .technology .text-link {
    width: min(var(--container), calc(100% - (var(--gutter) * 2)));
    margin: 0 auto;
    color: white;
    border-color: rgba(255, 255, 255, 0.45);
  }

  .technology .text-link:hover {
    color: #8caaff;
    border-color: #8caaff;
  }

  /* -----------------------------------------
     COMPANY
  ----------------------------------------- */

  .company {
    padding: 135px 0;
    background: var(--color-white);
    border-bottom: 1px solid var(--color-border);
  }

  .company-grid {
    width: min(var(--container), calc(100% - (var(--gutter) * 2)));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.55fr);
    gap: 120px;
  }

  .company h2 {
    max-width: 800px;
  }

  .company-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 35px;
    align-content: start;
    padding-top: 8px;
  }

  .detail {
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
  }

  .detail > span {
    color: var(--color-blue);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .detail p {
    margin: 14px 0 0;
    color: var(--color-text);
    font-size: 14px;
    line-height: 1.8;
  }

  .detail a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .detail a:hover {
    color: var(--color-blue);
  }

  /* -----------------------------------------
     CTA
  ----------------------------------------- */

  .about-cta {
    padding: 135px 0;
    background: #eef4ff;
  }

  .about-cta > div {
    width: min(850px, calc(100% - (var(--gutter) * 2)));
    margin: 0 auto;
    text-align: center;
  }

  .about-cta .section-eyebrow {
    justify-content: center;
  }

  .about-cta .section-eyebrow::before {
    display: none;
  }

  .about-cta h2 {
    font-size: clamp(44px, 5vw, 68px);
  }

  .about-cta p:not(.section-eyebrow) {
    max-width: 540px;
    margin: 28px auto 0;
    color: var(--color-text);
    font-size: 17px;
    line-height: 1.75;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-top: 35px;
    padding: 15px 22px;
    background: var(--color-blue);
    color: white;
    font-size: 13px;
    font-weight: 650;
    text-decoration: none;
    transition:
      transform 160ms ease,
      background 160ms ease;
  }

  .cta-button:hover {
    background: var(--color-ink);
    transform: translateY(-2px);
  }

  .cta-button span {
    font-size: 17px;
  }

  /* -----------------------------------------
     RESPONSIVE
  ----------------------------------------- */

  @media (max-width: 1100px) {
    .hero-grid {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: 0;
    }

    .hero-content {
      padding-bottom: 45px;
    }

    .hero-visual {
      height: 570px;
    }

    .section-grid,
    .principles {
      gap: 70px;
    }

    .capability-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .technology-list {
      grid-template-columns: repeat(3, 1fr);
    }

    .company-grid {
      gap: 70px;
    }
  }

