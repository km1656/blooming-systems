---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page Not Found | Blooming Systems Inc."
  description="The page you're looking for could not be found."
  noindex={true}
>
  <main class="error-page">
    <div class="error-grid" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>

    <div class="error-container">
      <div class="error-mark" aria-hidden="true">
        <span>404</span>
      </div>

      <p class="section-eyebrow">PAGE NOT FOUND</p>

      <h1>
        The page you're looking for
        <span>doesn't exist.</span>
      </h1>

      <p class="error-copy">
        The link may be outdated, the address may have changed, or the page
        may have been moved. Let's get you back to the right place.
      </p>

      <div class="error-actions">
        <a href="/" class="primary-button">
          Back to home
          <span aria-hidden="true">↗</span>
        </a>

        <a href="/services/" class="secondary-button">
          Explore services
        </a>

        <a href="/contact/" class="text-link">
          Contact us
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="identity-lines" aria-hidden="true">
      <span class="line line-one"></span>
      <span class="line line-two"></span>
      <span class="node node-one"></span>
      <span class="node node-two"></span>
      <span class="node node-three"></span>
    </div>
  </main>
</Layout>

<style>
  .error-page {
    position: relative;
    display: flex;
    align-items: center;
    min-height: calc(100vh - 82px);
    padding: 150px var(--gutter) 120px;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 78% 38%,
        rgba(0, 49, 255, 0.08),
        transparent 30%
      ),
      #eef4ff;
  }

  .error-container {
    position: relative;
    z-index: 2;
    width: min(var(--container), 100%);
    margin: 0 auto;
  }

  .error-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 112px;
    height: 112px;
    margin-bottom: 48px;
    border: 1px solid rgba(0, 49, 255, 0.18);
    background: rgba(255, 255, 255, 0.72);
    box-shadow:
      0 20px 60px rgba(7, 21, 47, 0.08),
      inset 0 0 0 8px rgba(0, 49, 255, 0.025);
  }

  .error-mark span {
    color: var(--color-blue);
    font-size: 28px;
    font-weight: 750;
    letter-spacing: -0.05em;
  }

  .section-eyebrow {
    margin-bottom: 24px;
  }

  h1 {
    max-width: 760px;
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(48px, 6vw, 88px);
    font-weight: 650;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  h1 span {
    display: block;
    color: var(--color-blue);
  }

  .error-copy {
    max-width: 570px;
    margin: 34px 0 0;
    color: var(--color-text);
    font-size: 17px;
    line-height: 1.75;
  }

  .error-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 26px;
    margin-top: 42px;
  }

  .primary-button,
  .secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 22px;
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 650;
    transition:
      transform 160ms ease,
      background 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  .primary-button {
    gap: 14px;
    color: var(--color-white);
    background: var(--color-blue);
    border: 1px solid var(--color-blue);
  }

  .primary-button:hover {
    transform: translateY(-2px);
    background: var(--color-ink);
    border-color: var(--color-ink);
  }

  .primary-button span {
    font-size: 16px;
  }

  .secondary-button {
    color: var(--color-ink);
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid var(--color-border);
  }

  .secondary-button:hover {
    transform: translateY(-2px);
    border-color: var(--color-blue);
    color: var(--color-blue);
  }

  .text-link {
    margin-left: 4px;
  }

  /* Decorative identity network */

  .identity-lines {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .line {
    position: absolute;
    display: block;
    height: 1px;
    background: linear-gradient(
      90deg,
      rgba(0, 49, 255, 0),
      rgba(0, 49, 255, 0.18),
      rgba(0, 49, 255, 0)
    );
    transform-origin: left center;
  }

  .line-one {
    top: 33%;
    right: -4%;
    width: 48%;
    transform: rotate(-24deg);
  }

  .line-two {
    top: 63%;
    right: -5%;
    width: 52%;
    transform: rotate(18deg);
  }

  .node {
    position: absolute;
    display: block;
    width: 10px;
    height: 10px;
    border: 2px solid rgba(0, 49, 255, 0.35);
    background: #ffffff;
    border-radius: 50%;
    box-shadow: 0 0 0 7px rgba(0, 49, 255, 0.04);
  }

  .node-one {
    top: 29%;
    right: 27%;
  }

  .node-two {
    top: 49%;
    right: 11%;
  }

  .node-three {
    bottom: 24%;
    right: 31%;
  }

  .error-grid {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 48%;
    opacity: 0.35;
    background-image:
      linear-gradient(
        rgba(0, 49, 255, 0.045) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(0, 49, 255, 0.045) 1px,
        transparent 1px
      );
    background-size: 70px 70px;
    mask-image: linear-gradient(
      90deg,
      transparent,
      black 35%,
      black
    );
  }

  @media (max-width: 800px) {
    .error-page {
      min-height: calc(100vh - 72px);
      padding-top: 120px;
      padding-bottom: 100px;
    }

    .error-mark {
      width: 92px;
      height: 92px;
      margin-bottom: 38px;
    }

    h1 {
      max-width: 650px;
      font-size: clamp(46px, 11vw, 70px);
    }

    .error-copy {
      font-size: 16px;
    }

    .error-grid {
      width: 70%;
      opacity: 0.25;
    }

    .line-one {
      width: 65%;
    }

    .line-two {
      width: 70%;
    }
  }

  @media (max-width: 560px) {
    .error-page {
      padding-top: 100px;
      padding-bottom: 80px;
    }

    .error-mark {
      width: 78px;
      height: 78px;
      margin-bottom: 32px;
    }

    .error-mark span {
      font-size: 23px;
    }

    h1 {
      font-size: clamp(42px, 13vw, 60px);
    }

    .error-copy {
      margin-top: 26px;
    }

    .error-actions {
      align-items: stretch;
      flex-direction: column;
      gap: 14px;
      max-width: 300px;
      margin-top: 34px;
    }

    .primary-button,
    .secondary-button {
      width: 100%;
    }

    .text-link {
      align-self: flex-start;
      margin-top: 6px;
      margin-left: 0;
    }

    .error-grid {
      width: 100%;
      opacity: 0.18;
    }

    .node-one {
      right: 22%;
    }

    .node-two {
      right: 7%;
    }

    .node-three {
      right: 18%;
    }
  }
</style>