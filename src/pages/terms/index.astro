---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Terms of Use | Blooming Systems Inc."
  description="Terms of Use for the Blooming Systems Inc. website."
>
  <main>
    <section class="legal-hero">
      <div class="legal-container">
        <p class="section-eyebrow">LEGAL</p>
        <h1>Terms of Use</h1>
        <p class="legal-intro">
          These Terms of Use govern your access to and use of the Blooming
          Systems Inc. website.
        </p>
        <p class="effective-date">Effective Date: September 27, 2026</p>
      </div>
    </section>

    <section class="legal-content">
      <div class="legal-layout">
        <aside class="legal-nav" aria-label="Terms of Use sections">
          <span>CONTENTS</span>
          <a href="#acceptance">Acceptance</a>
          <a href="#website-use">Website Use</a>
          <a href="#information">Information</a>
          <a href="#intellectual-property">Intellectual Property</a>
          <a href="#third-party">Third-Party Links</a>
          <a href="#disclaimer">Disclaimer</a>
          <a href="#liability">Limitation of Liability</a>
          <a href="#indemnification">Indemnification</a>
          <a href="#changes">Changes</a>
          <a href="#governing-law">Governing Law</a>
          <a href="#contact">Contact</a>
        </aside>

        <article class="legal-body">
          <section id="acceptance">
            <h2>Acceptance of Terms</h2>

            <p>
              These Terms of Use ("Terms") govern your access to and use of
              the Blooming Systems Inc. website at
              <strong> bloomingsys.com</strong> (the "Website").
            </p>

            <p>
              By accessing or using the Website, you acknowledge that you have
              read, understood, and agree to be bound by these Terms. If you
              do not agree with these Terms, please do not use the Website.
            </p>

            <p>
              Blooming Systems Inc. may update these Terms from time to time.
              Your continued use of the Website after an updated version is
              posted constitutes use subject to the updated Terms.
            </p>
          </section>

          <section id="website-use">
            <h2>Use of the Website</h2>

            <p>
              The Website is provided for general informational and business
              purposes. You may use the Website only for lawful purposes and
              in a manner that does not interfere with its operation or
              security.
            </p>

            <p>
              You agree not to use the Website to attempt to gain unauthorized
              access to systems or information, interfere with the Website or
              its infrastructure, introduce malicious code, or engage in
              activity that violates applicable law.
            </p>
          </section>

          <section id="information">
            <h2>Information Submitted Through the Website</h2>

            <p>
              If you submit information through a contact form or other
              communication feature, you are responsible for ensuring that the
              information you provide is accurate and that you have the right
              to provide it.
            </p>

            <p>
              Information submitted through the Website may be handled in
              accordance with our
              <a href="/privacy/">Privacy Policy</a>.
            </p>
          </section>

          <section id="intellectual-property">
            <h2>Intellectual Property</h2>

            <p>
              Unless otherwise indicated, the content of the Website,
              including text, graphics, logos, visual elements, designs, and
              other materials, is owned by or licensed to Blooming Systems
              Inc. and may be protected by applicable intellectual property
              laws.
            </p>

            <p>
              You may view the Website and its content for personal or
              legitimate business informational purposes. You may not
              reproduce, distribute, modify, publish, transmit, or create
              derivative works from Website content without appropriate
              authorization, except where permitted by applicable law.
            </p>

            <p>
              Blooming Systems Inc. and related names, logos, and branding
              elements may constitute trademarks or service marks. No right
              to use them is granted by these Terms.
            </p>
          </section>

          <section id="third-party">
            <h2>Third-Party Links</h2>

            <p>
              The Website may contain links to third-party websites,
              platforms, or services. These links are provided for
              convenience and informational purposes.
            </p>

            <p>
              Blooming Systems Inc. does not control and is not responsible
              for the content, availability, security, or practices of
              third-party websites. Accessing third-party websites is at your
              own discretion and subject to their respective terms and
              policies.
            </p>
          </section>

          <section id="disclaimer">
            <h2>Disclaimer</h2>

            <p>
              The information provided on the Website is for general
              informational purposes only. Although Blooming Systems Inc.
              seeks to provide useful and accurate information, we do not
              warrant that Website content will always be complete, current,
              accurate, or error-free.
            </p>

            <p>
              Information presented on the Website does not constitute legal,
              financial, regulatory, cybersecurity, or other professional
              advice for a particular situation. Professional services are
              provided pursuant to applicable agreements and statements of
              work.
            </p>

            <p>
              To the extent permitted by applicable law, the Website and its
              content are provided on an "as is" and "as available" basis
              without warranties of any kind, whether express or implied.
            </p>
          </section>

          <section id="liability">
            <h2>Limitation of Liability</h2>

            <p>
              To the fullest extent permitted by applicable law, Blooming
              Systems Inc. and its officers, directors, employees, contractors,
              and service providers will not be liable for indirect,
              incidental, special, consequential, exemplary, or punitive
              damages arising from or related to your access to or use of the
              Website.
            </p>

            <p>
              Nothing in these Terms is intended to exclude or limit
              liability that cannot lawfully be excluded or limited under
              applicable law.
            </p>
          </section>

          <section id="indemnification">
            <h2>Indemnification</h2>

            <p>
              To the extent permitted by applicable law, you agree to
              indemnify and hold harmless Blooming Systems Inc. and its
              officers, directors, employees, contractors, and agents from
              claims, liabilities, damages, losses, and expenses arising from
              your unlawful use of the Website or your violation of these
              Terms.
            </p>
          </section>

          <section id="changes">
            <h2>Changes to the Website and Terms</h2>

            <p>
              Blooming Systems Inc. may modify, suspend, or discontinue any
              portion of the Website at any time without notice.
            </p>

            <p>
              We may also revise these Terms from time to time. Changes become
              effective when posted on this page unless otherwise stated. The
              effective date shown above identifies the current version.
            </p>
          </section>

          <section id="governing-law">
            <h2>Governing Law</h2>

            <p>
              These Terms are intended to be interpreted under the laws
              applicable to Blooming Systems Inc. and its operations, without
              regard to conflict-of-law principles, except to the extent
              otherwise required by applicable law.
            </p>

            <p>
              Any specific contractual relationship for professional services
              may be governed by separate agreements containing their own
              governing-law and dispute-resolution provisions.
            </p>
          </section>

          <section id="contact">
            <h2>Contact Us</h2>

            <p>
              If you have questions about these Terms of Use, please contact:
            </p>

            <address>
              <strong>Blooming Systems Inc.</strong><br />
              21951 Purebred Lane<br />
              Escondido, CA 92029<br />
              <a href="tel:+18587407673">858 740 7673</a>
            </address>

            <a class="legal-button" href="/contact/">
              Contact Blooming Systems
              <span>↗</span>
            </a>
          </section>
        </article>
      </div>
    </section>
  </main>
</Layout>

<style>
  .legal-hero {
    padding: 145px 0 105px;
    background: #eef4ff;
    border-bottom: 1px solid var(--color-border);
  }

  .legal-container {
    width: min(900px, calc(100% - (var(--gutter) * 2)));
    margin: 0 auto;
  }

  .legal-hero h1 {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(48px, 6vw, 76px);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .legal-intro {
    max-width: 680px;
    margin: 30px 0 0;
    color: var(--color-text);
    font-size: 18px;
    line-height: 1.75;
  }

  .effective-date {
    margin: 30px 0 0;
    color: var(--color-muted);
    font-size: 12px;
    font-weight: 600;
  }

  .legal-content {
    padding: 110px 0 140px;
  }

  .legal-layout {
    width: min(1120px, calc(100% - (var(--gutter) * 2)));
    margin: 0 auto;
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 90px;
    align-items: start;
  }

  .legal-nav {
    position: sticky;
    top: 110px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .legal-nav span {
    margin-bottom: 8px;
    color: var(--color-blue);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .legal-nav a {
    color: var(--color-muted);
    font-size: 12px;
    line-height: 1.4;
    text-decoration: none;
  }

  .legal-nav a:hover {
    color: var(--color-blue);
  }

  .legal-body {
    max-width: 760px;
  }

  .legal-body section {
    margin-bottom: 70px;
    scroll-margin-top: 110px;
  }

  .legal-body section:last-child {
    margin-bottom: 0;
  }

  .legal-body h2 {
    margin: 0 0 22px;
    color: var(--color-ink);
    font-size: 30px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .legal-body p {
    margin: 0 0 20px;
    color: var(--color-text);
    font-size: 15px;
    line-height: 1.85;
  }

  .legal-body p:last-child {
    margin-bottom: 0;
  }

  .legal-body strong {
    color: var(--color-ink);
    font-weight: 650;
  }

  .legal-body a:not(.legal-button) {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: rgba(0, 49, 255, 0.35);
    text-underline-offset: 3px;
  }

  .legal-body a:not(.legal-button):hover {
    color: var(--color-blue);
    text-decoration-color: var(--color-blue);
  }

  .legal-body address {
    margin-top: 25px;
    padding: 25px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 14px;
    font-style: normal;
    line-height: 1.8;
  }

  .legal-body address a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .legal-body address a:hover {
    color: var(--color-blue);
  }

  .legal-button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 28px;
    padding: 14px 20px;
    background: var(--color-blue);
    color: var(--color-white);
    font-size: 13px;
    font-weight: 650;
    text-decoration: none;
    transition:
      background 160ms ease,
      transform 160ms ease;
  }

  .legal-button:hover {
    background: var(--color-ink);
    transform: translateY(-2px);
  }

  .legal-button span {
    font-size: 16px;
  }

  @media (max-width: 900px) {
    .legal-layout {
      grid-template-columns: 1fr;
      gap: 55px;
    }

    .legal-nav {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px 25px;
      padding-bottom: 35px;
      border-bottom: 1px solid var(--color-border);
    }

    .legal-nav span {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .legal-hero {
      padding: 90px 0 75px;
    }

    .legal-content {
      padding: 75px 0 90px;
    }

    .legal-body section {
      margin-bottom: 55px;
    }

    .legal-body h2 {
      font-size: 27px;
    }

    .legal-nav {
      grid-template-columns: 1fr;
    }

    .legal-nav span {
      grid-column: auto;
    }
  }
  .section-eyebrow{
    font-size: 15px;
  }
</style>